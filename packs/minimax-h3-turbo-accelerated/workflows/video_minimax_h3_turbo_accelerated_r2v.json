{
  "h3_unet": {
    "inputs": { "unet_name": "{{unet}}", "weight_dtype": "default" },
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Diffusion Model" }
  },
  "h3_clip": {
    "inputs": { "clip_name": "{{clip}}", "type": "minimax", "device": "default" },
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load CLIP" }
  },
  "h3_video_vae": {
    "inputs": { "vae_name": "{{vae}}" },
    "class_type": "VAELoader",
    "_meta": { "title": "Load Video VAE" }
  },
  "h3_audio_vae": {
    "inputs": { "vae_name": "{{audio_vae}}" },
    "class_type": "VAELoader",
    "_meta": { "title": "Load Audio VAE" }
  },
  "simpligen_lora_1": {
    "inputs": {
      "PowerLoraLoaderHeaderWidget": { "type": "PowerLoraLoaderHeaderWidget" },
      "➕ Add Lora": "",
      "model": ["h3_unet", 0],
      "clip": ["h3_clip", 0]
    },
    "class_type": "Power Lora Loader (rgthree)",
    "_meta": { "title": "SimpliGen User LoRAs" }
  },
  "h3_turbo_lora": {
    "inputs": {
      "model": ["simpligen_lora_1", 0],
      "lora_name": "minimax_h3_turbo_v4_step600_ema.safetensors",
      "strength": 1,
      "low_vram": false
    },
    "class_type": "MiniMaxH3TurboLoRA",
    "_meta": { "title": "MiniMax H3 Turbo LoRA" }
  },
  "h3_sage_attn": {
    "inputs": {
      "model": ["h3_turbo_lora", 0],
      "sage_attention": "auto",
      "allow_compile": false
    },
    "class_type": "PathchSageAttentionKJ",
    "_meta": { "title": "Patch Sage Attention (KJ)" }
  },
  "h3_sigma_shift": {
    "inputs": {
      "model": ["h3_sage_attn", 0],
      "shift_video": 12.0,
      "shift_audio": 3.0
    },
    "class_type": "MiniMaxH3SigmaShift",
    "_meta": { "title": "MiniMax H3 Sigma Shift" }
  },
  "h3_spectrum": {
    "inputs": {
      "model": ["h3_sigma_shift", 0],
      "enabled": true,
      "blend_weight": 0.50,
      "degree": 1,
      "ridge_lambda": 0.10,
      "window_size": 2.0,
      "flex_window": 0.75,
      "warmup_steps": 1,
      "tail_actual_steps": 1,
      "max_history": 8,
      "debug": false,
      "history_storage": "system_ram",
      "bootstrap_first_forecast": true,
      "anchor_residual_feedback": false,
      "selective_rollback_correction": false,
      "offline_smoothing_replay": true,
      "audio_blend_weight": 0.0,
      "offline_archive_storage": "system_ram"
    },
    "class_type": "SpectrumApplyMiniMaxH3",
    "_meta": { "title": "Spectrum Apply MiniMax H3" }
  },
  "h3_sol_attn": {
    "inputs": {
      "model": ["h3_spectrum", 0],
      "tau": 1.3,
      "start_percent": 0.2,
      "end_percent": 0.9,
      "min_tokens": 4096,
      "int8_qk": true,
      "sink_conditioning": "exact_kv_and_rows",
      "morton": false,
      "morton_curve": "2d_frame",
      "int8_pv": true,
      "verbose": false,
      "use_tma": false,
      "dense_blocks": ""
    },
    "class_type": "SolAttnPatch",
    "_meta": { "title": "Patch Sol-Attn" }
  },
  "h3_conditioning": {
    "inputs": {
      "clip": ["simpligen_lora_1", 1],
      "vae": ["h3_video_vae", 0],
      "audio_vae": ["h3_audio_vae", 0],
      "prompt": "{{prompt}}",
      "width": "{{width}}",
      "height": "{{height}}",
      "length": ["h3_length", 1],
      "ref_image_size": "match",
      "ref_images.ref_image_0": ["sgopt_ref_image_1__load", 0],
      "ref_images.ref_image_1": ["sgopt_ref_image_2__load", 0],
      "ref_images.ref_image_2": ["sgopt_ref_image_3__load", 0],
      "ref_images.ref_image_3": ["sgopt_ref_image_4__load", 0],
      "ref_images.ref_image_4": ["sgopt_ref_image_5__load", 0],
      "ref_images.ref_image_5": ["sgopt_ref_image_6__load", 0],
      "ref_images.ref_image_6": ["sgopt_ref_image_7__load", 0],
      "ref_images.ref_image_7": ["sgopt_ref_image_8__load", 0],
      "ref_images.ref_image_8": ["sgopt_ref_image_9__load", 0],
      "ref_videos.ref_video_0": ["sgopt_ref_video_1__components", 0],
      "ref_video_audios.ref_video_audio_0": ["sgopt_ref_video_audio_1__load", 0],
      "ref_videos.ref_video_1": ["sgopt_ref_video_2__components", 0],
      "ref_video_audios.ref_video_audio_1": ["sgopt_ref_video_audio_2__load", 0],
      "ref_videos.ref_video_2": ["sgopt_ref_video_3__components", 0],
      "ref_video_audios.ref_video_audio_2": ["sgopt_ref_video_audio_3__load", 0],
      "ref_audios.ref_audio_0": ["sgopt_ref_audio_1__load", 0],
      "ref_audios.ref_audio_1": ["sgopt_ref_audio_2__load", 0],
      "ref_audios.ref_audio_2": ["sgopt_ref_audio_3__load", 0]
    },
    "class_type": "MiniMaxH3ReferenceToVideo",
    "_meta": { "title": "MiniMax H3 Reference to Video" }
  },
  "sgopt_ref_video_1__load": {
    "inputs": { "file": "{{ref_video_1}}" },
    "class_type": "LoadVideo",
    "_meta": { "title": "Reference Clip 1" }
  },
  "sgopt_ref_video_1__trim": {
    "inputs": {
      "video": ["sgopt_ref_video_1__load", 0],
      "start_time": 0,
      "duration": 15,
      "strict_duration": false
    },
    "class_type": "Video Slice",
    "_meta": { "title": "Trim Reference Clip 1 to 15s" }
  },
  "sgopt_ref_video_1__components": {
    "inputs": { "video": ["sgopt_ref_video_1__trim", 0] },
    "class_type": "GetVideoComponents",
    "_meta": { "title": "Reference Clip 1 frames + sound" }
  },
  "sgopt_ref_video_2__load": {
    "inputs": { "file": "{{ref_video_2}}" },
    "class_type": "LoadVideo",
    "_meta": { "title": "Reference Clip 2" }
  },
  "sgopt_ref_video_2__trim": {
    "inputs": {
      "video": ["sgopt_ref_video_2__load", 0],
      "start_time": 0,
      "duration": 15,
      "strict_duration": false
    },
    "class_type": "Video Slice",
    "_meta": { "title": "Trim Reference Clip 2 to 15s" }
  },
  "sgopt_ref_video_2__components": {
    "inputs": { "video": ["sgopt_ref_video_2__trim", 0] },
    "class_type": "GetVideoComponents",
    "_meta": { "title": "Reference Clip 2 frames + sound" }
  },
  "sgopt_ref_video_3__load": {
    "inputs": { "file": "{{ref_video_3}}" },
    "class_type": "LoadVideo",
    "_meta": { "title": "Reference Clip 3" }
  },
  "sgopt_ref_video_3__trim": {
    "inputs": {
      "video": ["sgopt_ref_video_3__load", 0],
      "start_time": 0,
      "duration": 15,
      "strict_duration": false
    },
    "class_type": "Video Slice",
    "_meta": { "title": "Trim Reference Clip 3 to 15s" }
  },
  "sgopt_ref_video_3__components": {
    "inputs": { "video": ["sgopt_ref_video_3__trim", 0] },
    "class_type": "GetVideoComponents",
    "_meta": { "title": "Reference Clip 3 frames + sound" }
  },
  "sgopt_ref_video_audio_1__load": {
    "inputs": { "audio": "{{ref_video_audio_1}}" },
    "class_type": "LoadAudio",
    "_meta": { "title": "Reference Clip 1 soundtrack" }
  },
  "sgopt_ref_video_audio_2__load": {
    "inputs": { "audio": "{{ref_video_audio_2}}" },
    "class_type": "LoadAudio",
    "_meta": { "title": "Reference Clip 2 soundtrack" }
  },
  "sgopt_ref_video_audio_3__load": {
    "inputs": { "audio": "{{ref_video_audio_3}}" },
    "class_type": "LoadAudio",
    "_meta": { "title": "Reference Clip 3 soundtrack" }
  },
  "sgopt_ref_audio_1__load": {
    "inputs": { "audio": "{{ref_audio_1}}" },
    "class_type": "LoadAudio",
    "_meta": { "title": "Reference Sound 1" }
  },
  "sgopt_ref_audio_2__load": {
    "inputs": { "audio": "{{ref_audio_2}}" },
    "class_type": "LoadAudio",
    "_meta": { "title": "Reference Sound 2" }
  },
  "sgopt_ref_audio_3__load": {
    "inputs": { "audio": "{{ref_audio_3}}" },
    "class_type": "LoadAudio",
    "_meta": { "title": "Reference Sound 3" }
  },
  "sgopt_ref_image_1__load": {
    "inputs": { "image": "{{ref_image_1}}", "upload": "image" },
    "class_type": "LoadImage",
    "_meta": { "title": "Reference Image 1" }
  },
  "sgopt_ref_image_2__load": {
    "inputs": { "image": "{{ref_image_2}}", "upload": "image" },
    "class_type": "LoadImage",
    "_meta": { "title": "Reference Image 2" }
  },
  "sgopt_ref_image_3__load": {
    "inputs": { "image": "{{ref_image_3}}", "upload": "image" },
    "class_type": "LoadImage",
    "_meta": { "title": "Reference Image 3" }
  },
  "sgopt_ref_image_4__load": {
    "inputs": { "image": "{{ref_image_4}}", "upload": "image" },
    "class_type": "LoadImage",
    "_meta": { "title": "Reference Image 4" }
  },
  "sgopt_ref_image_5__load": {
    "inputs": { "image": "{{ref_image_5}}", "upload": "image" },
    "class_type": "LoadImage",
    "_meta": { "title": "Reference Image 5" }
  },
  "sgopt_ref_image_6__load": {
    "inputs": { "image": "{{ref_image_6}}", "upload": "image" },
    "class_type": "LoadImage",
    "_meta": { "title": "Reference Image 6" }
  },
  "sgopt_ref_image_7__load": {
    "inputs": { "image": "{{ref_image_7}}", "upload": "image" },
    "class_type": "LoadImage",
    "_meta": { "title": "Reference Image 7" }
  },
  "sgopt_ref_image_8__load": {
    "inputs": { "image": "{{ref_image_8}}", "upload": "image" },
    "class_type": "LoadImage",
    "_meta": { "title": "Reference Image 8" }
  },
  "sgopt_ref_image_9__load": {
    "inputs": { "image": "{{ref_image_9}}", "upload": "image" },
    "class_type": "LoadImage",
    "_meta": { "title": "Reference Image 9" }
  },
  "h3_noise": {
    "inputs": { "noise_seed": "{{seed}}" },
    "class_type": "RandomNoise",
    "_meta": { "title": "Random Noise" }
  },
  "h3_guider": {
    "inputs": { "model": ["h3_sol_attn", 0], "conditioning": ["h3_conditioning", 0] },
    "class_type": "BasicGuider",
    "_meta": { "title": "Guider" }
  },
  "h3_sampler": {
    "inputs": {},
    "class_type": "MiniMaxH3TurboSampler",
    "_meta": { "title": "MiniMax H3 Turbo Sampler (4-step)" }
  },
  "h3_sigmas": {
    "inputs": {
      "model": ["h3_sol_attn", 0],
      "scheduler": "simple",
      "steps": "{{steps}}",
      "denoise": 1
    },
    "class_type": "BasicScheduler",
    "_meta": { "title": "Scheduler" }
  },
  "h3_sampling": {
    "inputs": {
      "noise": ["h3_noise", 0],
      "guider": ["h3_guider", 0],
      "sampler": ["h3_sampler", 0],
      "sigmas": ["h3_sigmas", 0],
      "latent_image": ["h3_conditioning", 1]
    },
    "class_type": "SamplerCustomAdvanced",
    "_meta": { "title": "Sample" }
  },
  "h3_decode_video": {
    "inputs": { "samples": ["h3_sampling", 0], "vae": ["h3_video_vae", 0] },
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode Video" }
  },
  "h3_decode_audio": {
    "inputs": { "samples": ["h3_sampling", 0], "vae": ["h3_audio_vae", 0] },
    "class_type": "VAEDecodeAudio",
    "_meta": { "title": "Decode Audio" }
  },
  "h3_create_video": {
    "inputs": {
      "images": ["h3_decode_video", 0],
      "fps": 24,
      "audio": ["h3_decode_audio", 0],
      "bit_depth": 8
    },
    "class_type": "CreateVideo",
    "_meta": { "title": "Create Video" }
  },
  "h3_save": {
    "inputs": {
      "video": ["h3_create_video", 0],
      "filename_prefix": "video/MiniMax_H3_turbo_accelerated_r2v",
      "format": "auto",
      "codec": "auto"
    },
    "class_type": "SaveVideo",
    "_meta": { "title": "Save Video" }
  },
  "h3_duration": {
    "inputs": { "value": "{{duration}}" },
    "class_type": "PrimitiveFloat",
    "_meta": { "title": "Duration (seconds)" }
  },
  "h3_length": {
    "inputs": {
      "expression": "min(362, max(124, max(5, round(a * 24)) + (17 - (max(5, round(a * 24)) - 5) % 17) % 17))",
      "values.a": ["h3_duration", 0]
    },
    "class_type": "ComfyMathExpression",
    "_meta": { "title": "Frame Length" }
  }
}
