    {
      "id": "illustrij-v21",
      "name": "IllustriJ V21",
      "tagline": "Comic-anime hybrid with soft 3D depth",
      "icon": "🎨",
      "previewImage": "previews/illustrij-v21.jpg",
      "description": "A comic and anime hybrid with digital-art rendering and a touch of 3D, heading toward semi-realism. It has a recognisable look of its own that the author calls an ID model. It makes general and mature pictures, and the author moved it toward a more adult look from v19.\n\nUse Danbooru tags. The card adds no quality tags, so start with the author's: masterpiece, best quality.\n\nThe author's settings include a 1.5x hi-res pass, which this card does not run.\n\nFor softer anime pick AniMiJ. For something closer to realism pick ILustREAL.\n\nLicence: Illustrious License. Read it before commercial use.\n\nModel format: fp16, not quantized.",
      "tags": [
        "Illustrious",
        "Anime",
        "Semi-Realistic",
        "Digital Art",
        "Local"
      ],
      "enabled": true,
      "template": "sdxl",
      "ui": {
        "visibleFields": [
          "content",
          "aspectRatio",
          "shotType",
          "environment",
          "lightingSource",
          "atmosphere"
        ]
      },
