{
  "h3_unet": {
    "inputs": {
      "unet_name": "{{unet}}",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "MiniMax H3 Diffusion Model"
    }
  },
  "h3_clip": {
    "inputs": {
      "clip_name": "{{clip}}",
      "type": "minimax",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Qwen3-VL Text Encoder (MiniMax)"
    }
  },
  "h3_video_vae": {
    "inputs": {
      "vae_name": "{{vae}}"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Video VAE"
    }
  },
  "h3_audio_vae": {
    "inputs": {
      "vae_name": "{{audio_vae}}"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Audio VAE"
    }
  },
  "simpligen_lora_1": {
    "inputs": {
      "PowerLoraLoaderHeaderWidget": {
        "type": "PowerLoraLoaderHeaderWidget"
      },
      "➕ Add Lora": "",
      "model": [
        "h3_unet",
        0
      ],
      "clip": [
        "h3_clip",
        0
      ]
    },
    "class_type": "Power Lora Loader (rgthree)",
    "_meta": {
      "title": "SimpliGen User LoRAs"
    }
  },
  "h3_conditioning": {
    "inputs": {
      "clip": [
        "simpligen_lora_1",
        1
      ],
      "vae": [
        "h3_video_vae",
        0
      ],
      "prompt": "{{prompt}}",
      "width": "{{width}}",
      "height": "{{height}}",
      "length": [
        "h3_length",
        1
      ]
    },
    "class_type": "MiniMaxH3ImageToVideo",
    "_meta": {
      "title": "MiniMax H3 Text to Video"
    }
  },
  "h3_noise": {
    "inputs": {
      "noise_seed": "{{seed}}"
    },
    "class_type": "RandomNoise",
    "_meta": {
      "title": "Random Noise"
    }
  },
  "h3_guider": {
    "inputs": {
      "model": [
        "simpligen_lora_1",
        0
      ],
      "conditioning": [
        "h3_conditioning",
        0
      ]
    },
    "class_type": "BasicGuider",
    "_meta": {
      "title": "Basic Guider"
    }
  },
  "h3_sampler": {
    "inputs": {
      "sampler_name": "res_multistep"
    },
    "class_type": "KSamplerSelect",
    "_meta": {
      "title": "KSampler Select"
    }
  },
  "h3_sigmas": {
    "inputs": {
      "model": [
        "simpligen_lora_1",
        0
      ],
      "scheduler": "simple",
      "steps": "{{steps}}",
      "denoise": 1
    },
    "class_type": "BasicScheduler",
    "_meta": {
      "title": "Basic Scheduler"
    }
  },
  "h3_sampling": {
    "inputs": {
      "noise": [
        "h3_noise",
        0
      ],
      "guider": [
        "h3_guider",
        0
      ],
      "sampler": [
        "h3_sampler",
        0
      ],
      "sigmas": [
        "h3_sigmas",
        0
      ],
      "latent_image": [
        "h3_conditioning",
        1
      ]
    },
    "class_type": "SamplerCustomAdvanced",
    "_meta": {
      "title": "SamplerCustomAdvanced"
    }
  },
  "h3_decode_video": {
    "inputs": {
      "samples": [
        "h3_sampling",
        0
      ],
      "vae": [
        "h3_video_vae",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "h3_decode_audio": {
    "inputs": {
      "samples": [
        "h3_sampling",
        0
      ],
      "vae": [
        "h3_audio_vae",
        0
      ]
    },
    "class_type": "VAEDecodeAudio",
    "_meta": {
      "title": "VAE Decode Audio"
    }
  },
  "h3_create_video": {
    "inputs": {
      "images": [
        "h3_decode_video",
        0
      ],
      "fps": 24,
      "audio": [
        "h3_decode_audio",
        0
      ],
      "bit_depth": 8
    },
    "class_type": "CreateVideo",
    "_meta": {
      "title": "Create Video"
    }
  },
  "h3_save": {
    "inputs": {
      "video": [
        "h3_create_video",
        0
      ],
      "filename_prefix": "video/MiniMax_H3_t2v",
      "format": "auto",
      "codec": "auto"
    },
    "class_type": "SaveVideo",
    "_meta": {
      "title": "Save Video"
    }
  },
  "h3_duration": {
    "inputs": {
      "value": "{{duration}}"
    },
    "class_type": "PrimitiveFloat",
    "_meta": {
      "title": "Duration (seconds)"
    }
  },
  "h3_length": {
    "inputs": {
      "expression": "min(362, max(124, max(5, round(a * 24)) + (17 - (max(5, round(a * 24)) - 5) % 17) % 17))",
      "values.a": [
        "h3_duration",
        0
      ]
    },
    "class_type": "ComfyMathExpression",
    "_meta": {
      "title": "Snap length to the 17k+5 grid"
    }
  }
}