{
  "4": {
    "inputs": { "ckpt_name": "{{checkpoint}}" },
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "Load DucHaiten NoobAI-Cinematic v1.0 Snapvu" }
  },
  "simpligen_lora_1": {
    "inputs": {
      "PowerLoraLoaderHeaderWidget": { "type": "PowerLoraLoaderHeaderWidget" },
      "➕ Add Lora": "",
      "model": ["4", 0],
      "clip": ["4", 1]
    },
    "class_type": "Power Lora Loader (rgthree)",
    "_meta": { "title": "SimpliGen User LoRAs" }
  },
  "10": {
    "inputs": { "stop_at_clip_layer": -2, "clip": ["simpligen_lora_1", 1] },
    "class_type": "CLIPSetLastLayer",
    "_meta": { "title": "CLIP Skip 2" }
  },
  "5": {
    "inputs": { "width": "{{width}}", "height": "{{height}}", "batch_size": 1 },
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "Empty Latent Image" }
  },
  "6": {
    "inputs": { "text": "masterpiece, best quality, amazing quality, very aesthetic, {{prompt}}", "clip": ["10", 0] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive Prompt" }
  },
  "7": {
    "inputs": { "text": "{{negative_prompt}}", "clip": ["10", 0] },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative Prompt" }
  },
  "3": {
    "inputs": {
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "dpmpp_3m_sde",
      "scheduler": "simple",
      "denoise": 1,
      "model": ["simpligen_lora_1", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "Pass 1 - DPM++ 3M SDE / Simple" }
  },
  "8": {
    "inputs": { "samples": ["3", 0], "vae": ["4", 2] },
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode pass 1" }
  },
  "20": {
    "inputs": { "model_name": "{{upscaler}}" },
    "class_type": "UpscaleModelLoader",
    "_meta": { "title": "Load 4x-UltraSharpV2" }
  },
  "21": {
    "inputs": { "upscale_model": ["20", 0], "image": ["8", 0] },
    "class_type": "ImageUpscaleWithModel",
    "_meta": { "title": "Upscale 4x with model" }
  },
  "22": {
    "inputs": { "upscale_method": "lanczos", "scale_by": 0.375, "image": ["21", 0] },
    "class_type": "ImageScaleBy",
    "_meta": { "title": "Down to 1.5x of base" }
  },
  "23": {
    "inputs": { "pixels": ["22", 0], "vae": ["4", 2] },
    "class_type": "VAEEncode",
    "_meta": { "title": "Encode for hires pass" }
  },
  "24": {
    "inputs": {
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": 3,
      "sampler_name": "dpmpp_3m_sde",
      "scheduler": "simple",
      "denoise": 0.3,
      "model": ["simpligen_lora_1", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["23", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "Hires pass - denoise 0.3, CFG 3" }
  },
  "25": {
    "inputs": { "samples": ["24", 0], "vae": ["4", 2], "tile_size": 1024, "overlap": 64, "temporal_size": 64, "temporal_overlap": 8 },
    "class_type": "VAEDecodeTiled",
    "_meta": { "title": "Decode hires (tiled)" }
  },
  "9": {
    "inputs": { "filename_prefix": "duchaiten-noobai-cinematic-snapvu-v10", "images": ["25", 0] },
    "class_type": "SaveImage",
    "_meta": { "title": "Save Image" }
  }
}
