{
  "sg_unet": {
    "inputs": {
      "unet_name": "{{unet}}",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Diffusion Model"
    }
  },
  "sg_clip": {
    "inputs": {
      "clip_name": "{{clip}}",
      "type": "qwen_image",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load Qwen3-VL 8B"
    }
  },
  "sg_vae": {
    "inputs": {
      "vae_name": "{{vae}}"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load VAE"
    }
  },
  "simpligen_lora_1": {
    "inputs": {
      "PowerLoraLoaderHeaderWidget": {
        "type": "PowerLoraLoaderHeaderWidget"
      },
      "➕ Add Lora": "",
      "model": [
        "sg_charref_lora",
        0
      ],
      "clip": [
        "sg_clip",
        0
      ]
    },
    "class_type": "Power Lora Loader (rgthree)",
    "_meta": {
      "title": "SimpliGen User LoRAs"
    }
  },
  "sg_charref_lora": {
    "inputs": {
      "model": [
        "sg_unet",
        0
      ],
      "lora_name": "qwen21_portrait2charref_v1.safetensors",
      "strength_model": 1
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "Portrait2CharRef LoRA"
    }
  },
  "sg_cache": {
    "inputs": {
      "model": [
        "simpligen_lora_1",
        0
      ],
      "device": "auto",
      "dtype": "default"
    },
    "class_type": "QwenImage21Cache",
    "_meta": {
      "title": "Reference prefix cache"
    }
  },
  "sgopt_ref_image_1__load": {
    "inputs": {
      "image": "{{ref_image_1}}"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "The person"
    }
  },
  "sgopt_ref_image_2__load": {
    "inputs": {
      "image": "{{ref_image_2}}"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Outfit (optional)"
    }
  },
  "sgopt_ref_image_2__flag": {
    "inputs": {
      "value": true
    },
    "class_type": "PrimitiveBoolean",
    "_meta": {
      "title": "Outfit picture supplied"
    }
  },
  "brief_keep": {
    "inputs": {
      "value": "把单个人物立绘重绘成包含正面、背面与头部多角度特写的角色设定图,图像中间是大头像,左侧是无头正面全身图,右侧是全身背面图,大头像下方是两个侧面小头像,保留原角色服装,保留原图细节,白色背景。"
    },
    "class_type": "PrimitiveStringMultiline",
    "_meta": {
      "title": "Brief: keep the person's own clothes"
    }
  },
  "brief_outfit": {
    "inputs": {
      "value": "把图1的人物重绘成包含正面、背面与头部多角度特写的角色设定图,图像中间是大头像,左侧是无头正面全身图,右侧是全身背面图,大头像下方是两个侧面小头像,人物穿着图2的服装,保留原图细节,白色背景。"
    },
    "class_type": "PrimitiveStringMultiline",
    "_meta": {
      "title": "Brief: wear the outfit from picture 2"
    }
  },
  "outfit_supplied": {
    "inputs": {
      "values.value0": false,
      "values.value1": [
        "sgopt_ref_image_2__flag",
        0
      ]
    },
    "class_type": "ComfyOrNode",
    "_meta": {
      "title": "Was an outfit picture supplied?"
    }
  },
  "brief_pick": {
    "inputs": {
      "switch": [
        "outfit_supplied",
        0
      ],
      "on_true": [
        "brief_outfit",
        0
      ],
      "on_false": [
        "brief_keep",
        0
      ]
    },
    "class_type": "ComfySwitchNode",
    "_meta": {
      "title": "Pick the brief"
    }
  },
  "brief_full": {
    "inputs": {
      "string_a": [
        "brief_pick",
        0
      ],
      "string_b": "{{prompt}}",
      "delimiter": " "
    },
    "class_type": "StringConcatenate",
    "_meta": {
      "title": "Brief + your notes"
    }
  },
  "sg_encode": {
    "inputs": {
      "clip": [
        "simpligen_lora_1",
        1
      ],
      "vae": [
        "sg_vae",
        0
      ],
      "prompt": [
        "brief_full",
        0
      ],
      "negative_prompt": "{{negative_prompt}}",
      "resolution": 1024,
      "images.image_1": [
        "sgopt_ref_image_1__load",
        0
      ],
      "images.image_2": [
        "sgopt_ref_image_2__load",
        0
      ]
    },
    "class_type": "TextEncodeQwenImage21",
    "_meta": {
      "title": "Brief + pictures"
    }
  },
  "sg_latent": {
    "inputs": {
      "width": {{width}},
      "height": {{height}},
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "Sheet size"
    }
  },
  "sg_sampler": {
    "inputs": {
      "seed": {{seed}},
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1,
      "model": [
        "sg_cache",
        0
      ],
      "positive": [
        "sg_encode",
        0
      ],
      "negative": [
        "sg_encode",
        1
      ],
      "latent_image": [
        "sg_latent",
        0
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler"
    }
  },
  "sg_decode": {
    "inputs": {
      "samples": [
        "sg_sampler",
        0
      ],
      "vae": [
        "sg_vae",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "sg_save": {
    "inputs": {
      "filename_prefix": "qwen_image_21_character_sheet",
      "images": [
        "sg_decode",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save"
    }
  }
}