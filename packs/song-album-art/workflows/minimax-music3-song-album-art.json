{
  "split_style": {
    "inputs": {
      "string": "{{prompt}}",
      "regex_pattern": "\\A(.*?)\\s*(?:\\[lyrics\\]|\\Z)",
      "mode": "First Group",
      "case_insensitive": true,
      "multiline": false,
      "dotall": true,
      "group_index": 1
    },
    "class_type": "RegexExtract",
    "_meta": {
      "title": "Style = text before [lyrics]"
    }
  },
  "split_lyrics": {
    "inputs": {
      "string": "{{prompt}}",
      "regex_pattern": "\\[lyrics\\]\\s*(.*)\\Z",
      "mode": "First Group",
      "case_insensitive": true,
      "multiline": false,
      "dotall": true,
      "group_index": 1
    },
    "class_type": "RegexExtract",
    "_meta": {
      "title": "Lyrics = text after [lyrics]"
    }
  },
  "music_unet": {
    "inputs": {
      "unet_name": "{{unet}}",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "MiniMax Music 3 DiT"
    }
  },
  "music_clip": {
    "inputs": {
      "clip_name": "{{clip}}",
      "type": "minimax",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "MiniMax Music 3 text encoder"
    }
  },
  "music_vae": {
    "inputs": {
      "vae_name": "{{vae}}"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "MiniMax Music 3 DAV"
    }
  },
  "music_encode": {
    "inputs": {
      "clip": [
        "music_clip",
        0
      ],
      "caption": [
        "split_style",
        0
      ],
      "lyrics": [
        "split_lyrics",
        0
      ],
      "seed": "{{seed}}",
      "max_duration": "{{duration}}",
      "cfg_scale": 1.7,
      "top_k": 50
    },
    "class_type": "MiniMaxMusic3TextEncode",
    "_meta": {
      "title": "Caption + lyrics -> song tokens"
    }
  },
  "music_negative": {
    "inputs": {
      "conditioning": [
        "music_encode",
        0
      ]
    },
    "class_type": "ConditioningZeroOut",
    "_meta": {
      "title": "Negative (zeroed)"
    }
  },
  "music_latent": {
    "inputs": {
      "seconds": [
        "music_encode",
        1
      ],
      "batch_size": 1
    },
    "class_type": "EmptyMiniMaxMusic3LatentAudio",
    "_meta": {
      "title": "Latent sized to the song the encoder made"
    }
  },
  "music_sampler": {
    "inputs": {
      "model": [
        "music_unet",
        0
      ],
      "positive": [
        "music_encode",
        0
      ],
      "negative": [
        "music_negative",
        0
      ],
      "latent_image": [
        "music_latent",
        0
      ],
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": 1.7,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "Music 3 sampler"
    }
  },
  "music_decode": {
    "inputs": {
      "samples": [
        "music_sampler",
        0
      ],
      "vae": [
        "music_vae",
        0
      ],
      "tile_size": 1536,
      "overlap": 64
    },
    "class_type": "VAEDecodeAudioTiled",
    "_meta": {
      "title": "Decode song"
    }
  },
  "sgopt_ref_image_1__load": {
    "inputs": {
      "image": "{{ref_image_1}}",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Your album art"
    }
  },
  "sgopt_ref_image_1__fit": {
    "inputs": {
      "image": [
        "sgopt_ref_image_1__load",
        0
      ],
      "upscale_method": "lanczos",
      "width": "{{width}}",
      "height": "{{height}}",
      "crop": "center"
    },
    "class_type": "ImageScale",
    "_meta": {
      "title": "Fit album art to the output size"
    }
  },
  "sgopt_ref_image_1__flag": {
    "inputs": {
      "value": true
    },
    "class_type": "PrimitiveBoolean",
    "_meta": {
      "title": "Album art supplied"
    }
  },
  "art_imagery": {
    "inputs": {
      "string": [
        "split_style",
        0
      ],
      "regex_pattern": "(?is)^.*?application scenarios\\s*&\\s*imagery\\s*:\\s*([^\\n]+).*$",
      "replace": "\\1",
      "case_insensitive": true
    },
    "class_type": "RegexReplace",
    "_meta": {
      "title": "Art prompt: use MiniMax's Imagery line when present"
    }
  },
  "art_clean_triggers": {
    "inputs": {
      "string": [
        "art_imagery",
        0
      ],
      "regex_pattern": "\\b[\\w-]*_[\\w-]*\\b[,.;]?\\s*",
      "replace": "",
      "case_insensitive": true
    },
    "class_type": "RegexReplace",
    "_meta": {
      "title": "Art prompt: drop LoRA trigger words"
    }
  },
  "art_clean_bpm": {
    "inputs": {
      "string": [
        "art_clean_triggers",
        0
      ],
      "regex_pattern": "(?i)\\b(bpm\\s*(is\\s*)?\\d{2,3}|\\d{2,3}\\s*-?\\s*bpm)\\b[,.;]?\\s*",
      "replace": "",
      "case_insensitive": true
    },
    "class_type": "RegexReplace",
    "_meta": {
      "title": "Art prompt: drop tempos"
    }
  },
  "art_clean_key": {
    "inputs": {
      "string": [
        "art_clean_bpm",
        0
      ],
      "regex_pattern": "(?i:key\\s+is\\s+)[A-Ga-g](?:\\s*(?i:flat|sharp)|#|b)?(?=[\\s,.;]|$)[,.;]?\\s*(?i:and\\s+)?(?i:scale\\s+is\\s+)?(?i:major|minor)?[,.;]?\\s*|\\b[A-G](?:\\s*(?i:flat|sharp)|#|b)?\\s+(?i:major|minor)\\b[,.;]?\\s*",
      "replace": "",
      "case_insensitive": false
    },
    "class_type": "RegexReplace",
    "_meta": {
      "title": "Art prompt: drop keys and scales"
    }
  },
  "art_clean_labels": {
    "inputs": {
      "string": [
        "art_clean_key",
        0
      ],
      "regex_pattern": "(?im)\\b(global metadata|basic attributes|global emotional progression|vocal details|arrangement)\\s*:\\s*|^\\s*(global metadata|basic attributes|global emotional progression|vocal details|arrangement)\\s*$",
      "replace": "",
      "case_insensitive": true
    },
    "class_type": "RegexReplace",
    "_meta": {
      "title": "Art prompt: drop section labels"
    }
  },
  "art_cap_words": {
    "inputs": {
      "string": [
        "art_clean_labels",
        0
      ],
      "regex_pattern": "(?s)^\\s*((?:\\S+\\s+){59}\\S+).*$",
      "replace": "\\1",
      "case_insensitive": true
    },
    "class_type": "RegexReplace",
    "_meta": {
      "title": "Art prompt: keep the first 60 words"
    }
  },
  "cover_prompt": {
    "inputs": {
      "string_a": "Album cover artwork, a single striking image with no text, no letters, no logos and no border, visualizing this music:",
      "string_b": [
        "art_cap_words",
        0
      ],
      "delimiter": " "
    },
    "class_type": "StringConcatenate",
    "_meta": {
      "title": "Album art prompt"
    }
  },
  "cover_unet": {
    "inputs": {
      "unet_name": "{{cover_unet}}",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Qwen-Image 2.1"
    }
  },
  "cover_clip": {
    "inputs": {
      "clip_name": "{{cover_clip}}",
      "type": "qwen_image",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Qwen3-VL 8B encoder"
    }
  },
  "cover_vae": {
    "inputs": {
      "vae_name": "{{cover_vae}}"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Qwen-Image 2.1 VAE"
    }
  },
  "cover_encode": {
    "inputs": {
      "clip": [
        "cover_clip",
        0
      ],
      "vae": [
        "cover_vae",
        0
      ],
      "prompt": [
        "cover_prompt",
        0
      ],
      "negative_prompt": "",
      "resolution": 1024
    },
    "class_type": "TextEncodeQwenImage21",
    "_meta": {
      "title": "Album art prompt encode"
    }
  },
  "cover_latent": {
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "Album art latent"
    }
  },
  "cover_sample": {
    "inputs": {
      "seed": "{{seed}}",
      "steps": 25,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1,
      "model": [
        "cover_unet",
        0
      ],
      "positive": [
        "cover_encode",
        0
      ],
      "negative": [
        "cover_encode",
        1
      ],
      "latent_image": [
        "cover_latent",
        0
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "Paint album art"
    }
  },
  "cover_decode": {
    "inputs": {
      "samples": [
        "cover_sample",
        0
      ],
      "vae": [
        "cover_vae",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decode album art"
    }
  },
  "cover_rgb": {
    "inputs": {
      "image": [
        "cover_decode",
        0
      ]
    },
    "class_type": "SplitImageWithAlpha",
    "_meta": {
      "title": "Drop the alpha channel"
    }
  },
  "cover_supplied": {
    "inputs": {
      "values.value0": false,
      "values.value1": [
        "sgopt_ref_image_1__flag",
        0
      ]
    },
    "class_type": "ComfyOrNode",
    "_meta": {
      "title": "Was album art supplied?"
    }
  },
  "cover_pick": {
    "inputs": {
      "switch": [
        "cover_supplied",
        0
      ],
      "on_true": [
        "sgopt_ref_image_1__fit",
        0
      ],
      "on_false": [
        "cover_rgb",
        0
      ]
    },
    "class_type": "ComfySwitchNode",
    "_meta": {
      "title": "Your album art, else painted art"
    }
  },
  "frame_count": {
    "inputs": {
      "expression": "ceil(a * 1)",
      "values.a": [
        "music_encode",
        1
      ]
    },
    "class_type": "ComfyMathExpression",
    "_meta": {
      "title": "Frames = ceil(song seconds x fps)"
    }
  },
  "frames": {
    "inputs": {
      "image": [
        "cover_pick",
        0
      ],
      "amount": [
        "frame_count",
        1
      ]
    },
    "class_type": "RepeatImageBatch",
    "_meta": {
      "title": "Hold the album art"
    }
  },
  "video": {
    "inputs": {
      "images": [
        "frames",
        0
      ],
      "fps": 1,
      "audio": [
        "music_decode",
        0
      ]
    },
    "class_type": "CreateVideo",
    "_meta": {
      "title": "Album art + song"
    }
  },
  "9000": {
    "inputs": {
      "video": [
        "video",
        0
      ],
      "filename_prefix": "video/MiniMax_Music3_album_art",
      "format": "auto",
      "codec": "auto"
    },
    "class_type": "SaveVideo",
    "_meta": {
      "title": "Save MP4"
    }
  }
}
