{
  "sg_unet": {
    "inputs": {
      "unet_name": "{{unet}}",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Ming-Image 0.1 Design"
    }
  },
  "sg_clip": {
    "inputs": {
      "clip_name": "{{clip}}",
      "type": "qwen_image",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load Ling-Mini 2.0 encoder"
    }
  },
  "sg_vae": {
    "inputs": {
      "vae_name": "{{vae}}"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load VAE"
    }
  },
  "simpligen_lora_1": {
    "inputs": {
      "PowerLoraLoaderHeaderWidget": {
        "type": "PowerLoraLoaderHeaderWidget"
      },
      "➕ Add Lora": "",
      "model": [
        "sg_unet",
        0
      ],
      "clip": [
        "sg_clip",
        0
      ]
    },
    "class_type": "Power Lora Loader (rgthree)",
    "_meta": {
      "title": "SimpliGen User LoRAs"
    }
  },
  "sg_attn": {
    "inputs": {
      "model": [
        "simpligen_lora_1",
        0
      ],
      "attention": "comfy kitchen attention"
    },
    "class_type": "ModelAttentionBackend",
    "_meta": {
      "title": "Attention backend (as the Comfy template)"
    }
  },
  "sg_ref1": {
    "inputs": {
      "image": "{{ref_image_1}}"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Picture to change"
    }
  },
  "sg_ref2": {
    "inputs": {
      "image": "{{ref_image_2}}"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Mask picture (white = may change)"
    }
  },
  "sg_work": {
    "inputs": {
      "image": [
        "sg_ref1",
        0
      ],
      "upscale_method": "lanczos",
      "megapixels": 1.0,
      "resolution_steps": 64
    },
    "class_type": "ImageScaleToTotalPixels",
    "_meta": {
      "title": "Working size for the edit"
    }
  },
  "sg_worksize": {
    "inputs": {
      "image": [
        "sg_work",
        0
      ]
    },
    "class_type": "GetImageSize",
    "_meta": {
      "title": "Working size"
    }
  },
  "sg_encode": {
    "inputs": {
      "clip": [
        "simpligen_lora_1",
        1
      ],
      "vae": [
        "sg_vae",
        0
      ],
      "prompt": "{{prompt}}",
      "images.image_1": [
        "sg_work",
        0
      ]
    },
    "class_type": "TextEncodeMingImageEdit",
    "_meta": {
      "title": "Edit instruction + picture"
    }
  },
  "sg_shift": {
    "inputs": {
      "model": [
        "sg_attn",
        0
      ],
      "max_shift": 1.15,
      "base_shift": 0.5,
      "width": [
        "sg_worksize",
        0
      ],
      "height": [
        "sg_worksize",
        1
      ]
    },
    "class_type": "ModelSamplingFlux",
    "_meta": {
      "title": "Shift (size must match the latent)"
    }
  },
  "sg_guider": {
    "inputs": {
      "model": [
        "sg_shift",
        0
      ],
      "conditioning": [
        "sg_encode",
        0
      ]
    },
    "class_type": "BasicGuider",
    "_meta": {
      "title": "Guider (CFG 1)"
    }
  },
  "sg_sched": {
    "inputs": {
      "model": [
        "sg_shift",
        0
      ],
      "scheduler": "simple",
      "steps": {{steps}},
      "denoise": 1
    },
    "class_type": "BasicScheduler",
    "_meta": {
      "title": "Scheduler"
    }
  },
  "sg_samplersel": {
    "inputs": {
      "sampler_name": "euler"
    },
    "class_type": "KSamplerSelect",
    "_meta": {
      "title": "Sampler"
    }
  },
  "sg_noise": {
    "inputs": {
      "noise_seed": {{seed}}
    },
    "class_type": "RandomNoise",
    "_meta": {
      "title": "Seed"
    }
  },
  "sg_latent": {
    "inputs": {
      "width": [
        "sg_worksize",
        0
      ],
      "height": [
        "sg_worksize",
        1
      ],
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "Latent"
    }
  },
  "sg_sample": {
    "inputs": {
      "noise": [
        "sg_noise",
        0
      ],
      "guider": [
        "sg_guider",
        0
      ],
      "sampler": [
        "sg_samplersel",
        0
      ],
      "sigmas": [
        "sg_sched",
        0
      ],
      "latent_image": [
        "sg_latent",
        0
      ]
    },
    "class_type": "SamplerCustomAdvanced",
    "_meta": {
      "title": "Sample"
    }
  },
  "sg_decode": {
    "inputs": {
      "samples": [
        "sg_sample",
        0
      ],
      "vae": [
        "sg_vae",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "sg_origsize": {
    "inputs": {
      "image": [
        "sg_ref1",
        0
      ]
    },
    "class_type": "GetImageSize",
    "_meta": {
      "title": "Original size"
    }
  },
  "sg_editfull": {
    "inputs": {
      "image": [
        "sg_decode",
        0
      ],
      "upscale_method": "lanczos",
      "width": [
        "sg_origsize",
        0
      ],
      "height": [
        "sg_origsize",
        1
      ],
      "crop": "disabled"
    },
    "class_type": "ImageScale",
    "_meta": {
      "title": "Edit back to original size"
    }
  },
  "sg_maskfull": {
    "inputs": {
      "image": [
        "sg_ref2",
        0
      ],
      "upscale_method": "nearest-exact",
      "width": [
        "sg_origsize",
        0
      ],
      "height": [
        "sg_origsize",
        1
      ],
      "crop": "disabled"
    },
    "class_type": "ImageScale",
    "_meta": {
      "title": "Mask to original size"
    }
  },
  "sg_maskblur": {
    "inputs": {
      "image": [
        "sg_maskfull",
        0
      ],
      "blur_radius": 4,
      "sigma": 2.0
    },
    "class_type": "ImageBlur",
    "_meta": {
      "title": "Soften mask edge"
    }
  },
  "sg_mask": {
    "inputs": {
      "image": [
        "sg_maskblur",
        0
      ],
      "channel": "red"
    },
    "class_type": "ImageToMask",
    "_meta": {
      "title": "Mask"
    }
  },
  "sg_composite": {
    "inputs": {
      "destination": [
        "sg_ref1",
        0
      ],
      "source": [
        "sg_editfull",
        0
      ],
      "x": 0,
      "y": 0,
      "resize_source": false,
      "mask": [
        "sg_mask",
        0
      ]
    },
    "class_type": "ImageCompositeMasked",
    "_meta": {
      "title": "Paste the edit inside the mask only"
    }
  },
  "sg_save": {
    "inputs": {
      "filename_prefix": "ming_image_masked_edit",
      "images": [
        "sg_composite",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save"
    }
  }
}
