      "width": {{width}},
      "height": {{height}},
      "crop": "center"
    },
    "class_type": "ImageScale",
    "_meta": {
      "title": "First frame, fitted"
    }
  },
  "shot_header": {
    "inputs": {
      "string": "{{prompt}}",
      "regex_pattern": "\\A(.*?)(?:^[ \\t]*\\[Shot 1\\].*)?\\Z",
      "mode": "First Group",
      "case_insensitive": true,
      "multiline": true,
      "dotall": true,
      "group_index": 1
    },
    "class_type": "RegexExtract",
    "_meta": {
      "title": "Shared header (text before [Shot 1])"
    }
  },
  "shot_text_1": {
    "inputs": {
      "string": "{{prompt}}",
      "regex_pattern": "^[ \\t]*\\[Shot 1\\][ \\t]*(.*?)(?=\\n[ \\t]*\\[Shot \\d+\\]|\\Z)",
      "mode": "First Group",
      "case_insensitive": true,
      "multiline": true,
      "dotall": true,
      "group_index": 1
    },
    "class_type": "RegexExtract",
    "_meta": {
      "title": "[Shot 1] text"
    }
  },
  "shot_prompt_1": {
    "inputs": {
      "string_a": [
        "shot_header",
        0
      ],
      "string_b": [
        "shot_text_1",
        0
      ],
      "delimiter": "\n"
    },
    "class_type": "StringConcatenate",
    "_meta": {
      "title": "Prompt for clip 1"
    }
  },
  "clip1_cond": {
    "inputs": {
      "clip": [
        "simpligen_lora_1",
        1
      ],
      "vae": [
        "h3_video_vae",
        0
      ],
      "prompt": [
        "shot_prompt_1",
        0
      ],
      "width": {{width}},
      "height": {{height}},
      "length": 192,
      "first_frame": [
        "h3_first_frame_fit",
        0
