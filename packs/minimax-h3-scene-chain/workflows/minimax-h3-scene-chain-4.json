{
  "h3_unet": {
    "inputs": {
      "unet_name": "{{unet}}",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load H3 fl2va"
    }
  },
  "h3_clip": {
    "inputs": {
      "clip_name": "{{clip}}",
      "type": "minimax",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load text encoder"
    }
  },
  "h3_video_vae": {
    "inputs": {
      "vae_name": "{{vae}}"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load video VAE"
    }
  },
  "h3_audio_vae": {
    "inputs": {
      "vae_name": "{{audio_vae}}"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load audio VAE"
    }
  },
  "simpligen_attn_backend": {
    "inputs": {
      "model": [
        "simpligen_lora_1",
        0
      ],
      "attention": "comfy kitchen attention"
    },
    "class_type": "ModelAttentionBackend",
    "_meta": {
      "title": "SimpliGen Attention Backend"
    }
  },
  "simpligen_lora_1": {
    "inputs": {
      "PowerLoraLoaderHeaderWidget": {
        "type": "PowerLoraLoaderHeaderWidget"
      },
      "➕ Add Lora": "",
      "model": [
        "h3_unet",
        0
      ],
      "clip": [
        "h3_clip",
        0
      ]
    },
    "class_type": "Power Lora Loader (rgthree)",
    "_meta": {
      "title": "SimpliGen User LoRAs"
    }
  },
  "turbo_first": {
    "inputs": {
      "model": [
        "simpligen_attn_backend",
        0
      ],
      "lora_name": "minimax_h3_fl2v_turbo_4step_v1.2_768p_comfyui_bf16.safetensors",
      "strength_model": 0.8
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "fl2v turbo v1.2 (first clip)"
    }
  },
  "turbo_next": {
    "inputs": {
      "model": [
        "simpligen_attn_backend",
        0
      ],
      "lora_name": "minimax_h3_fl2v_turbo_4step_v1.2_768p_comfyui_bf16.safetensors",
      "strength_model": 0.75
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "fl2v turbo v1.2 (continuations)"
    }
  },
  "sampler_first": {
    "inputs": {
      "sampler_name": "euler"
    },
    "class_type": "KSamplerSelect",
    "_meta": {
      "title": "Sampler (first clip)"
    }
  },
  "sampler_next": {
    "inputs": {
      "sampler_name": "res_multistep"
    },
    "class_type": "KSamplerSelect",
    "_meta": {
      "title": "Sampler (continuations)"
    }
  },
  "sigmas_first": {
    "inputs": {
      "model": [
        "turbo_first",
        0
      ],
      "scheduler": "simple",
      "steps": "{{steps}}",
      "denoise": 1
    },
    "class_type": "BasicScheduler",
    "_meta": {
      "title": "Sigmas (first clip)"
    }
  },
  "sigmas_next": {
    "inputs": {
      "model": [
        "turbo_next",
        0
      ],
      "scheduler": "simple",
      "steps": "{{steps}}",
      "denoise": 1
    },
    "class_type": "BasicScheduler",
    "_meta": {
      "title": "Sigmas (continuations)"
    }
  },
  "seed_base": {
    "inputs": {
      "value": {{seed}}
    },
    "class_type": "PrimitiveInt",
    "_meta": {
      "title": "Seed"
    }
  },
  "h3_load_image": {
    "inputs": {
      "image": "{{ref_image_1}}",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "First frame"
    }
  },
  "h3_first_frame_fit": {
    "inputs": {
      "image": [
        "h3_load_image",
        0
      ],
