    "class_type": "MiniMaxH3ImageToVideo",
    "_meta": {
      "title": "Clip 1: conditioning"
    }
  },
  "clip1_seed": {
    "inputs": {
      "expression": "a + 0",
      "values.a": [
        "seed_base",
        0
      ]
    },
    "class_type": "ComfyMathExpression",
    "_meta": {
      "title": "Clip 1: seed"
    }
  },
  "clip1_noise": {
    "inputs": {
      "noise_seed": [
        "clip1_seed",
        1
      ]
    },
    "class_type": "RandomNoise",
    "_meta": {
      "title": "Clip 1: noise"
    }
  },
  "clip1_guider": {
    "inputs": {
      "model": [
        "turbo_first",
        0
      ],
      "conditioning": [
        "clip1_cond",
        0
      ]
    },
    "class_type": "BasicGuider",
    "_meta": {
      "title": "Clip 1: guider"
    }
  },
  "clip1_sample": {
    "inputs": {
      "noise": [
        "clip1_noise",
        0
      ],
      "guider": [
        "clip1_guider",
        0
      ],
      "sampler": [
        "sampler_first",
        0
      ],
      "sigmas": [
        "sigmas_first",
        0
      ],
      "latent_image": [
        "clip1_cond",
        1
      ]
    },
    "class_type": "SamplerCustomAdvanced",
    "_meta": {
      "title": "Clip 1: sample"
    }
  },
  "clip1_decode": {
    "inputs": {
      "samples": [
        "clip1_sample",
