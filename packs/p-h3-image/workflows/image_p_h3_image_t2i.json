{
  "sg_unet": {
    "inputs": {
      "unet_name": "{{unet}}",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load MiniMax H3 FL2VA"
    }
  },
  "sg_lora": {
    "inputs": {
      "model": [
        "sg_unet",
        0
      ],
      "lora_name": "p-h3-image_lora_bf16.safetensors",
      "strength_model": 1.0
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "P-H3-Image LoRA"
    }
  },
  "simpligen_lora_1": {
    "inputs": {
      "PowerLoraLoaderHeaderWidget": {
        "type": "PowerLoraLoaderHeaderWidget"
      },
      "➕ Add Lora": "",
      "model": [
        "sg_lora",
        0
      ]
    },
    "class_type": "Power Lora Loader (rgthree)",
    "_meta": {
      "title": "SimpliGen User LoRAs"
    }
  },
  "sg_shift": {
    "inputs": {
      "model": [
        "simpligen_lora_1",
        0
      ],
      "shift_video": 1.0,
      "shift_audio": 1.0
    },
    "class_type": "MiniMaxH3SigmaShift",
    "_meta": {
      "title": "Shift 1.0 / 1.0"
    }
  },
  "sg_te": {
    "inputs": {
      "clip_name": "p-h3-image_text_encoder_int8_convrot.safetensors",
      "type": "minimax",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load P-H3-Image text encoder"
    }
  },
  "sg_vae": {
    "inputs": {
      "vae_name": "{{vae}}"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load P-H3-Image VAE"
    }
  },
  "sg_ups": {
    "inputs": {
      "clip_name": "p-h3-image_prompt_upsampler_w4a8.safetensors",
      "type": "minimax",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load prompt upsampler"
    }
  },
  "sg_noise": {
    "inputs": {
      "noise_seed": {{seed}}
    },
    "class_type": "RandomNoise",
    "_meta": {
      "title": "Seed"
    }
  },
  "sg_sampler": {
    "inputs": {
      "sampler_name": "er_sde"
    },
    "class_type": "KSamplerSelect",
    "_meta": {
      "title": "Sampler"
    }
  },
  "sg_sigmas": {
    "inputs": {
      "sigmas": "1.0, 0.984753, 0.967905, 0.951688, 0.925372, 0.881923, 0.810083, 0.528718, 0.0"
    },
    "class_type": "ManualSigmas",
    "_meta": {
      "title": "8-step schedule"
    }
  },
  "sg_guider": {
    "inputs": {
      "model": [
        "sg_shift",
        0
      ],
      "conditioning": [
        "sg_cond",
        0
      ]
    },
    "class_type": "BasicGuider",
    "_meta": {
      "title": "Guider (no CFG)"
    }
  },
  "sg_sample": {
    "inputs": {
      "noise": [
        "sg_noise",
        0
      ],
      "guider": [
        "sg_guider",
        0
      ],
      "sampler": [
        "sg_sampler",
        0
      ],
      "sigmas": [
        "sg_sigmas",
        0
      ],
      "latent_image": [
        "sg_cond",
        1
      ]
    },
    "class_type": "SamplerCustomAdvanced",
    "_meta": {
      "title": "Sample"
    }
  },
  "sg_decode": {
    "inputs": {
      "samples": [
        "sg_sample",
        0
      ],
      "vae": [
        "sg_vae",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "sg_save": {
    "inputs": {
      "images": [
        "sg_decode",
        0
      ],
      "filename_prefix": "p_h3_image"
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save"
    }
  },
  "sg_ar": {
    "inputs": {
      "string_a": "Aspect ratio: ",
      "string_b": "{{aspectRatio}}",
      "delimiter": ""
    },
    "class_type": "StringConcatenate",
    "_meta": {
      "title": "Aspect ratio line"
    }
  },
  "sg_request": {
    "inputs": {
      "string_a": [
        "sg_ar",
        0
      ],
      "string_b": "{{prompt}}",
      "delimiter": "\nRequest: "
    },
    "class_type": "StringConcatenate",
    "_meta": {
      "title": "Upsampler input"
    }
  },
  "sg_upsample": {
    "inputs": {
      "clip": [
        "sg_ups",
        0
      ],
      "prompt": [
        "sg_request",
        0
      ],
      "max_length": 1536,
      "sampling_mode": "off",
      "thinking": true,
      "use_default_template": true,
      "mtp": "auto"
    },
    "class_type": "TextGenerateV2",
    "_meta": {
      "title": "Prompt upsampler"
    }
  },
  "sg_cond": {
    "inputs": {
      "clip": [
        "sg_te",
        0
      ],
      "prompt": [
        "sg_upsample",
        0
      ],
      "width": {{width}},
      "height": {{height}}
    },
    "class_type": "PH3ImageConditioning",
    "_meta": {
      "title": "p-h3-image Conditioning"
    }
  }
}
