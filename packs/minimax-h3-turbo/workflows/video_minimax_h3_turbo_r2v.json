{
  "h3_unet": {
    "inputs": { "unet_name": "{{unet}}", "weight_dtype": "default" },
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Diffusion Model" }
  },
  "h3_clip": {
    "inputs": { "clip_name": "{{clip}}", "type": "minimax", "device": "default" },
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load CLIP" }
  },
  "h3_video_vae": {
    "inputs": { "vae_name": "{{vae}}" },
    "class_type": "VAELoader",
    "_meta": { "title": "Load Video VAE" }
  },
  "h3_audio_vae": {
    "inputs": { "vae_name": "{{audio_vae}}" },
    "class_type": "VAELoader",
    "_meta": { "title": "Load Audio VAE" }
  },
  "simpligen_lora_1": {
    "inputs": {
      "PowerLoraLoaderHeaderWidget": { "type": "PowerLoraLoaderHeaderWidget" },
      "➕ Add Lora": "",
      "model": ["h3_unet", 0],
      "clip": ["h3_clip", 0]
    },
    "class_type": "Power Lora Loader (rgthree)",
    "_meta": { "title": "SimpliGen User LoRAs" }
  },
  "h3_turbo_lora": {
    "inputs": {
      "model": ["simpligen_lora_1", 0],
      "lora_name": "minimax_h3_turbo_4step_ckpt500.safetensors",
      "strength": 1
    },
    "class_type": "MiniMaxH3TurboLoRA",
    "_meta": { "title": "MiniMax H3 Turbo LoRA" }
  },
  "h3_conditioning": {
    "inputs": {
      "clip": ["simpligen_lora_1", 1],
      "vae": ["h3_video_vae", 0],
      "audio_vae": ["h3_audio_vae", 0],
      "prompt": "{{prompt}}",
      "width": "{{width}}",
      "height": "{{height}}",
      "length": ["h3_length", 1],
      "ref_image_size": "match",
      "ref_images.ref_image_0": ["sgopt_ref_image_1__load", 0],
      "ref_images.ref_image_1": ["sgopt_ref_image_2__load", 0],
      "ref_images.ref_image_2": ["sgopt_ref_image_3__load", 0],
      "ref_images.ref_image_3": ["sgopt_ref_image_4__load", 0],
      "ref_images.ref_image_4": ["sgopt_ref_image_5__load", 0],
      "ref_images.ref_image_5": ["sgopt_ref_image_6__load", 0],
      "ref_images.ref_image_6": ["sgopt_ref_image_7__load", 0],
      "ref_images.ref_image_7": ["sgopt_ref_image_8__load", 0],
      "ref_images.ref_image_8": ["sgopt_ref_image_9__load", 0],
      "ref_videos.ref_video_0": ["sgopt_ref_video_1__components", 0],
      "ref_video_audios.ref_video_audio_0": ["sgopt_ref_video_audio_1__load", 0],
      "ref_videos.ref_video_1": ["sgopt_ref_video_2__components", 0],
      "ref_video_audios.ref_video_audio_1": ["sgopt_ref_video_audio_2__load", 0],
      "ref_videos.ref_video_2": ["sgopt_ref_video_3__components", 0],
      "ref_video_audios.ref_video_audio_2": ["sgopt_ref_video_audio_3__load", 0],
      "ref_audios.ref_audio_0": ["sgopt_ref_audio_1__load", 0],
      "ref_audios.ref_audio_1": ["sgopt_ref_audio_2__load", 0],
      "ref_audios.ref_audio_2": ["sgopt_ref_audio_3__load", 0]
    },
    "class_type": "MiniMaxH3ReferenceToVideo",
    "_meta": { "title": "MiniMax H3 Reference Conditioning" }
  },
  "sgopt_ref_video_1__load": { "inputs": { "file": "{{ref_video_1}}" }, "class_type": "LoadVideo", "_meta": { "title": "Load Ref Video 1" } },
  "sgopt_ref_video_1__trim": { "inputs": { "video": ["sgopt_ref_video_1__load", 0], "start_time": 0, "duration": 15, "strict_duration": false }, "class_type": "Video Slice", "_meta": { "title": "Trim Ref Video 1" } },
  "sgopt_ref_video_1__components": { "inputs": { "video": ["sgopt_ref_video_1__trim", 0] }, "class_type": "GetVideoComponents", "_meta": { "title": "Ref Video 1 Components" } },
  "sgopt_ref_video_2__load": { "inputs": { "file": "{{ref_video_2}}" }, "class_type": "LoadVideo", "_meta": { "title": "Load Ref Video 2" } },
  "sgopt_ref_video_2__trim": { "inputs": { "video": ["sgopt_ref_video_2__load", 0], "start_time": 0, "duration": 15, "strict_duration": false }, "class_type": "Video Slice", "_meta": { "title": "Trim Ref Video 2" } },
  "sgopt_ref_video_2__components": { "inputs": { "video": ["sgopt_ref_video_2__trim", 0] }, "class_type": "GetVideoComponents", "_meta": { "title": "Ref Video 2 Components" } },
  "sgopt_ref_video_3__load": { "inputs": { "file": "{{ref_video_3}}" }, "class_type": "LoadVideo", "_meta": { "title": "Load Ref Video 3" } },
  "sgopt_ref_video_3__trim": { "inputs": { "video": ["sgopt_ref_video_3__load", 0], "start_time": 0, "duration": 15, "strict_duration": false }, "class_type": "Video Slice", "_meta": { "title": "Trim Ref Video 3" } },
  "sgopt_ref_video_3__components": { "inputs": { "video": ["sgopt_ref_video_3__trim", 0] }, "class_type": "GetVideoComponents", "_meta": { "title": "Ref Video 3 Components" } },
  "sgopt_ref_video_audio_1__load": { "inputs": { "audio": "{{ref_video_audio_1}}" }, "class_type": "LoadAudio", "_meta": { "title": "Load Ref Video Audio 1" } },
  "sgopt_ref_video_audio_2__load": { "inputs": { "audio": "{{ref_video_audio_2}}" }, "class_type": "LoadAudio", "_meta": { "title": "Load Ref Video Audio 2" } },
  "sgopt_ref_video_audio_3__load": { "inputs": { "audio": "{{ref_video_audio_3}}" }, "class_type": "LoadAudio", "_meta": { "title": "Load Ref Video Audio 3" } },
  "sgopt_ref_audio_1__load": { "inputs": { "audio": "{{ref_audio_1}}" }, "class_type": "LoadAudio", "_meta": { "title": "Load Ref Audio 1" } },
  "sgopt_ref_audio_2__load": { "inputs": { "audio": "{{ref_audio_2}}" }, "class_type": "LoadAudio", "_meta": { "title": "Load Ref Audio 2" } },
  "sgopt_ref_audio_3__load": { "inputs": { "audio": "{{ref_audio_3}}" }, "class_type": "LoadAudio", "_meta": { "title": "Load Ref Audio 3" } },
  "sgopt_ref_image_1__load": { "inputs": { "image": "{{ref_image_1}}", "upload": "image" }, "class_type": "LoadImage", "_meta": { "title": "Load Ref Image 1" } },
  "sgopt_ref_image_2__load": { "inputs": { "image": "{{ref_image_2}}", "upload": "image" }, "class_type": "LoadImage", "_meta": { "title": "Load Ref Image 2" } },
  "sgopt_ref_image_3__load": { "inputs": { "image": "{{ref_image_3}}", "upload": "image" }, "class_type": "LoadImage", "_meta": { "title": "Load Ref Image 3" } },
  "sgopt_ref_image_4__load": { "inputs": { "image": "{{ref_image_4}}", "upload": "image" }, "class_type": "LoadImage", "_meta": { "title": "Load Ref Image 4" } },
  "sgopt_ref_image_5__load": { "inputs": { "image": "{{ref_image_5}}", "upload": "image" }, "class_type": "LoadImage", "_meta": { "title": "Load Ref Image 5" } },
  "sgopt_ref_image_6__load": { "inputs": { "image": "{{ref_image_6}}", "upload": "image" }, "class_type": "LoadImage", "_meta": { "title": "Load Ref Image 6" } },
  "sgopt_ref_image_7__load": { "inputs": { "image": "{{ref_image_7}}", "upload": "image" }, "class_type": "LoadImage", "_meta": { "title": "Load Ref Image 7" } },
  "sgopt_ref_image_8__load": { "inputs": { "image": "{{ref_image_8}}", "upload": "image" }, "class_type": "LoadImage", "_meta": { "title": "Load Ref Image 8" } },
  "sgopt_ref_image_9__load": { "inputs": { "image": "{{ref_image_9}}", "upload": "image" }, "class_type": "LoadImage", "_meta": { "title": "Load Ref Image 9" } },
  "h3_noise": {
    "inputs": { "noise_seed": "{{seed}}" },
    "class_type": "RandomNoise",
    "_meta": { "title": "Random Noise" }
  },
  "h3_guider": {
    "inputs": { "model": ["h3_turbo_lora", 0], "conditioning": ["h3_conditioning", 0] },
    "class_type": "BasicGuider",
    "_meta": { "title": "Guider" }
  },
  "h3_sampler": {
    "inputs": {},
    "class_type": "MiniMaxH3TurboSampler",
    "_meta": { "title": "MiniMax H3 Turbo Sampler (4-step)" }
  },
  "h3_sigmas": {
    "inputs": {
      "model": ["h3_turbo_lora", 0],
      "scheduler": "simple",
      "steps": "{{steps}}",
      "denoise": 1
    },
    "class_type": "BasicScheduler",
    "_meta": { "title": "Scheduler" }
  },
  "h3_sampling": {
    "inputs": {
      "noise": ["h3_noise", 0],
      "guider": ["h3_guider", 0],
      "sampler": ["h3_sampler", 0],
      "sigmas": ["h3_sigmas", 0],
      "latent_image": ["h3_conditioning", 1]
    },
    "class_type": "SamplerCustomAdvanced",
    "_meta": { "title": "Sample" }
  },
  "h3_decode_video": {
    "inputs": { "samples": ["h3_sampling", 0], "vae": ["h3_video_vae", 0] },
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode Video" }
  },
  "h3_decode_audio": {
    "inputs": { "samples": ["h3_sampling", 0], "vae": ["h3_audio_vae", 0] },
    "class_type": "VAEDecodeAudio",
    "_meta": { "title": "Decode Audio" }
  },
  "h3_create_video": {
    "inputs": {
      "images": ["h3_decode_video", 0],
      "fps": 24,
      "audio": ["h3_decode_audio", 0],
      "bit_depth": 8
    },
    "class_type": "CreateVideo",
    "_meta": { "title": "Create Video" }
  },
  "h3_save": {
    "inputs": {
      "video": ["h3_create_video", 0],
      "filename_prefix": "video/MiniMax_H3_turbo_r2v",
      "format": "auto",
      "codec": "auto"
    },
    "class_type": "SaveVideo",
    "_meta": { "title": "Save Video" }
  },
  "h3_duration": {
    "inputs": { "value": "{{duration}}" },
    "class_type": "PrimitiveFloat",
    "_meta": { "title": "Duration (seconds)" }
  },
  "h3_length": {
    "inputs": {
      "expression": "min(362, max(124, max(5, round(a * 24)) + (17 - (max(5, round(a * 24)) - 5) % 17) % 17))",
      "values.a": ["h3_duration", 0]
    },
    "class_type": "ComfyMathExpression",
    "_meta": { "title": "Frame Length" }
  }
}
