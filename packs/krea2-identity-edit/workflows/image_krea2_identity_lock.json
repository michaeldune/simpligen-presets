{
  "unet": {
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Krea 2 checkpoint"
    },
    "inputs": {
      "unet_name": "{{unet}}",
      "weight_dtype": "default"
    }
  },
  "clip_loader": {
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Qwen3-VL encoder"
    },
    "inputs": {
      "clip_name": "{{clip}}",
      "type": "krea2",
      "device": "default"
    }
  },
  "vae_loader": {
    "class_type": "VAELoader",
    "_meta": {
      "title": "VAE"
    },
    "inputs": {
      "vae_name": "{{vae}}"
    }
  },
  "identity_lora": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "Krea 2 Identity Edit v1.2"
    },
    "inputs": {
      "lora_name": "krea2_identity_edit_v1_2.safetensors",
      "strength_model": 1,
      "model": [
        "unet",
        0
      ]
    }
  },
  "simpligen_lora_1": {
    "class_type": "Power Lora Loader (rgthree)",
    "_meta": {
      "title": "Your LoRAs"
    },
    "inputs": {
      "PowerLoraLoaderHeaderWidget": {
        "type": "PowerLoraLoaderHeaderWidget"
      },
      "\u2795 Add Lora": "",
      "model": [
        "identity_lora",
        0
      ],
      "clip": [
        "clip_loader",
        0
      ]
    }
  },
  "latent": {
    "class_type": "EmptySD3LatentImage",
    "_meta": {
      "title": "Output size"
    },
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "batch_size": 1
    }
  },
  "img1": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Reference 1"
    },
    "inputs": {
      "image": "{{ref_image_1}}"
    }
  },
  "img1_scale": {
    "class_type": "ImageScaleToTotalPixels",
    "_meta": {
      "title": "Fit reference 1 to 1 MP"
    },
    "inputs": {
      "upscale_method": "lanczos",
      "megapixels": 1,
      "resolution_steps": 1,
      "image": [
        "img1",
        0
      ]
    }
  },
  "enc1": {
    "class_type": "VAEEncode",
    "_meta": {
      "title": "Encode reference 1"
    },
    "inputs": {
      "pixels": [
        "img1_scale",
        0
      ],
      "vae": [
        "vae_loader",
        0
      ]
    }
  },
  "img2": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Reference 2"
    },
    "inputs": {
      "image": "{{ref_image_2}}"
    }
  },
  "img2_scale": {
    "class_type": "ImageScaleToTotalPixels",
    "_meta": {
      "title": "Fit reference 2 to 1 MP"
    },
    "inputs": {
      "upscale_method": "lanczos",
      "megapixels": 1,
      "resolution_steps": 1,
      "image": [
        "img2",
        0
      ]
    }
  },
  "enc2": {
    "class_type": "VAEEncode",
    "_meta": {
      "title": "Encode reference 2"
    },
    "inputs": {
      "pixels": [
        "img2_scale",
        0
      ],
      "vae": [
        "vae_loader",
        0
      ]
    }
  },
  "ref2_on": {
    "class_type": "PrimitiveBoolean",
    "_meta": {
      "title": "Second reference supplied"
    },
    "inputs": {
      "value": "{{ref_2_enabled}}"
    }
  },
  "patch_1ref": {
    "class_type": "Krea2EditModelPatch",
    "_meta": {
      "title": "Krea2 Edit source patch (1 ref)"
    },
    "inputs": {
      "model": [
        "simpligen_lora_1",
        0
      ],
      "source_latent": [
        "enc1",
        0
      ],
      "ref_boost": 4.0,
      "ref_boost_a": 1.0,
      "fit_mode": "fit",
      "vae": [
        "vae_loader",
        0
      ],
      "source_image": [
        "img1_scale",
        0
      ],
      "target_latent": [
        "latent",
        0
      ]
    }
  },
  "patch_2ref": {
    "class_type": "Krea2EditModelPatch",
    "_meta": {
      "title": "Krea2 Edit source patch (2 refs)"
    },
    "inputs": {
      "model": [
        "simpligen_lora_1",
        0
      ],
      "source_latent": [
        "enc1",
        0
      ],
      "ref_boost": 4.0,
      "ref_boost_a": 1.0,
      "fit_mode": "fit",
      "vae": [
        "vae_loader",
        0
      ],
      "source_image": [
        "img1_scale",
        0
      ],
      "target_latent": [
        "latent",
        0
      ],
      "source_latent_b": [
        "enc2",
        0
      ],
      "source_image_b": [
        "img2_scale",
        0
      ]
    }
  },
  "patch": {
    "class_type": "ComfySwitchNode",
    "_meta": {
      "title": "1 or 2 references"
    },
    "inputs": {
      "switch": [
        "ref2_on",
        0
      ],
      "on_false": [
        "patch_1ref",
        0
      ],
      "on_true": [
        "patch_2ref",
        0
      ]
    }
  },
  "pos_1ref": {
    "class_type": "Krea2EditGroundedEncode",
    "_meta": {
      "title": "Grounded encode"
    },
    "inputs": {
      "clip": [
        "simpligen_lora_1",
        1
      ],
      "prompt": "{{prompt}}",
      "grounding_px": 768,
      "system_prompt": "",
      "image": [
        "img1_scale",
        0
      ]
    }
  },
  "pos_2ref": {
    "class_type": "Krea2EditGroundedEncode",
    "_meta": {
      "title": "Grounded encode"
    },
    "inputs": {
      "clip": [
        "simpligen_lora_1",
        1
      ],
      "prompt": "{{prompt}}",
      "grounding_px": 768,
      "system_prompt": "",
      "image": [
        "img1_scale",
        0
      ],
      "image_b": [
        "img2_scale",
        0
      ]
    }
  },
  "pos": {
    "class_type": "ComfySwitchNode",
    "_meta": {
      "title": "pos conditioning"
    },
    "inputs": {
      "switch": [
        "ref2_on",
        0
      ],
      "on_false": [
        "pos_1ref",
        0
      ],
      "on_true": [
        "pos_2ref",
        0
      ]
    }
  },
  "neg_1ref": {
    "class_type": "Krea2EditGroundedEncode",
    "_meta": {
      "title": "Grounded encode"
    },
    "inputs": {
      "clip": [
        "simpligen_lora_1",
        1
      ],
      "prompt": "{{negative_prompt}}",
      "grounding_px": 768,
      "system_prompt": "",
      "image": [
        "img1_scale",
        0
      ]
    }
  },
  "neg_2ref": {
    "class_type": "Krea2EditGroundedEncode",
    "_meta": {
      "title": "Grounded encode"
    },
    "inputs": {
      "clip": [
        "simpligen_lora_1",
        1
      ],
      "prompt": "{{negative_prompt}}",
      "grounding_px": 768,
      "system_prompt": "",
      "image": [
        "img1_scale",
        0
      ],
      "image_b": [
        "img2_scale",
        0
      ]
    }
  },
  "neg": {
    "class_type": "ComfySwitchNode",
    "_meta": {
      "title": "neg conditioning"
    },
    "inputs": {
      "switch": [
        "ref2_on",
        0
      ],
      "on_false": [
        "neg_1ref",
        0
      ],
      "on_true": [
        "neg_2ref",
        0
      ]
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "_meta": {
      "title": "Sampler"
    },
    "inputs": {
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1,
      "model": [
        "patch",
        0
      ],
      "positive": [
        "pos",
        0
      ],
      "negative": [
        "neg",
        0
      ],
      "latent_image": [
        "latent",
        0
      ]
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decode"
    },
    "inputs": {
      "samples": [
        "sampler",
        0
      ],
      "vae": [
        "vae_loader",
        0
      ]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save"
    },
    "inputs": {
      "filename_prefix": "krea2_identity_edit",
      "images": [
        "decode",
        0
      ]
    }
  }
}
