        ],
        "cfg": 1,
        "steps": 8,
        "negativePrompt": "",
        "vramModel": {
          "floorGB": 8,
          "gbPerMpSecond": 0.38
        },
        "reclaimVramBeforeDecode": true,
        "acceptsAudio": false,
        "requirements": {
          "minVramGB": 12,
          "recommendedVramGB": 16,
          "minRamGB": 32,
          "sizeGB": 17,
          "notes": "The REDgraft diffusion model is an approximately 17 GB INT8 download. The Gemma4 encoder, LTX 2.5 video/audio VAEs, and the LTX 2.3 spatial upscaler are shared companion files; this text-to-video preset does not require a source image. The supplied Civitai JSON is an I2V ComfyUI configuration export and is not a runtime dependency, so only the safetensors model and this API workflow are installed."
        }
