  "h3_noise": {
    "inputs": {
      "noise_seed": "{{seed}}"
    },
    "class_type": "RandomNoise",
    "_meta": {
      "title": "Random Noise"
    }
  },
  "h3_guider": {
    "inputs": {
      "model": [
        "h3_turbo_lora",
        0
      ],
      "conditioning": [
        "h3_conditioning",
        0
      ]
    },
    "class_type": "BasicGuider",
    "_meta": {
      "title": "Guider"
    }
  },
  "h3_sampler": {
    "inputs": {},
    "class_type": "MiniMaxH3TurboSampler",
    "_meta": {
      "title": "MiniMax H3 Turbo Sampler (4-step)"
    }
  },
  "h3_sigmas": {
    "inputs": {
      "model": [
        "h3_turbo_lora",
        0
      ],
      "scheduler": "simple",
      "steps": "{{steps}}",
      "denoise": 1
    },
    "class_type": "BasicScheduler",
    "_meta": {
      "title": "Scheduler"
    }
  },
  "h3_sampling": {
    "inputs": {
      "noise": [
        "h3_noise",
        0
      ],
      "guider": [
        "h3_guider",
        0
      ],
      "sampler": [
        "h3_sampler",
        0
      ],
      "sigmas": [
        "h3_sigmas",
        0
      ],
      "latent_image": [
        "h3_conditioning",
        1
      ]
    },
    "class_type": "SamplerCustomAdvanced",
    "_meta": {
      "title": "Sample"
    }
  },
  "h3_decode_video": {
    "inputs": {
      "samples": [
        "h3_sampling",
        0
      ],
      "vae": [
        "h3_video_vae",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decode Video"
    }
  },
  "h3_decode_audio": {
    "inputs": {
      "samples": [
        "h3_sampling",
        0
      ],
      "vae": [
        "h3_audio_vae",
        0
      ]
    },
    "class_type": "VAEDecodeAudio",
    "_meta": {
      "title": "Decode Audio"
    }
  },
  "h3_create_video": {
    "inputs": {
      "images": [
        "h3_decode_video",
        0
      ],
      "fps": 24,
      "audio": [
        "h3_decode_audio",
        0
      ],
      "bit_depth": 8
    },
    "class_type": "CreateVideo",
    "_meta": {
      "title": "Create Video"
    }
  },
  "h3_save": {
    "inputs": {
      "video": [
        "h3_create_video",
        0
      ],
      "filename_prefix": "video/MiniMax_H3_tts_lipsync",
      "format": "auto",
      "codec": "auto"
    },
    "class_type": "SaveVideo",
    "_meta": {
      "title": "Save Video"
    }
  },
  "h3_duration": {
    "inputs": {
      "value": "{{duration}}"
    },
    "class_type": "PrimitiveFloat",
    "_meta": {
      "title": "Duration (seconds)"
    }
  },
  "h3_length": {
    "inputs": {
      "expression": "min(362, max(124, max(5, round(a * 24)) + (17 - (max(5, round(a * 24)) - 5) % 17) % 17))",
      "values.a": [
        "h3_duration",
        0
      ]
    },
    "class_type": "ComfyMathExpression",
    "_meta": {
      "title": "Frame Length"
    }
  },
  "h3_lipsync_load": {
    "class_type": "LoadAudio",
    "inputs": {
      "audio": "{{audio_file}}"
    },
    "_meta": {
      "title": "Voice sample (audio slot)"
    }
  },
  "tts_prompt": {
    "class_type": "PrimitiveStringMultiline",
    "_meta": {
      "title": "User prompt"
    },
    "inputs": {
      "value": "{{prompt}}"
    }
  },
  "tts_line": {
    "class_type": "RegexExtract",
    "_meta": {
      "title": "Spoken line = first \"quoted\" text"
    },
    "inputs": {
      "string": [
        "tts_prompt",
        0
      ],
      "regex_pattern": "[\"“]([^\"”]{2,})[\"”]",
      "mode": "First Group",
      "case_insensitive": false,
      "multiline": false,
      "dotall": true,
      "group_index": 1
    }
  },
  "tts_emotion_tag": {
    "class_type": "RegexExtract",
    "_meta": {
      "title": "[emotion: ...] tag (whole)"
    },
    "inputs": {
      "string": [
        "tts_prompt",
        0
      ],
      "regex_pattern": "\\[\\s*emotion\\s*:\\s*[^\\]]+\\]",
      "mode": "First Match",
      "case_insensitive": true,
      "multiline": false,
      "dotall": false,
      "group_index": 0
    }
  },
  "tts_emotion_text": {
    "class_type": "RegexExtract",
    "_meta": {
      "title": "[emotion: ...] tag (words)"
    },
    "inputs": {
      "string": [
        "tts_prompt",
        0
      ],
      "regex_pattern": "\\[\\s*emotion\\s*:\\s*([^\\]]+)\\]",
      "mode": "First Group",
      "case_insensitive": true,
      "multiline": false,
      "dotall": false,
      "group_index": 1
    }
  },
  "tts_has_emotion": {
    "class_type": "RegexMatch",
    "_meta": {
      "title": "Has an [emotion] tag?"
    },
    "inputs": {
      "string": [
        "tts_prompt",
        0
      ],
      "regex_pattern": "\\[\\s*emotion\\s*:",
      "case_insensitive": true,
      "multiline": false,
      "dotall": false
    }
  },
  "h3_prompt_clean": {
    "class_type": "StringReplace",
    "_meta": {
      "title": "Strip [emotion] tag"
    },
    "inputs": {
      "string": [
        "tts_prompt",
        0
      ],
      "find": [
        "tts_emotion_tag",
        0
      ],
      "replace": ""
    }
  },
  "h3_prompt_binding": {
    "class_type": "PrimitiveStringMultiline",
    "_meta": {
      "title": "Audio binding (fully_copy)"
    },
    "inputs": {
      "value": "<Audio 1>: fully_copy - reused 1:1 as the final audio track. It is the speaking character's own voice; the mouth follows these words exactly and closes when the line ends. No other voice is added."
    }
  },
  "h3_prompt_final": {
    "class_type": "StringConcatenate",
    "_meta": {
      "title": "H3 prompt = binding + user prompt"
    },
    "inputs": {
      "string_a": [
        "h3_prompt_binding",
        0
      ],
      "string_b": [
        "h3_prompt_clean",
        0
      ],
      "delimiter": "\n\n"
    }
  },
  "tts_model": {
    "class_type": "T8_IndexTTS25_ModelLoader",
    "_meta": {
      "title": "IndexTTS 2.5"
    },
    "inputs": {
      "model_name": "IndexTTS-2.5",
      "device": "auto",
      "precision": "auto",
      "acceleration_mode": "off",
      "use_cuda_kernel": false,
      "release_after_run": true,
      "recycle_after_runs": 0,
      "verify_hashes": false,
      "custom_model_path": "",
      "reference_device": "auto",
      "reuse_spk_cond_for_emo": false,
      "persistent_reference_cache": true,
      "download_missing": false,
      "accept_model_license": true
    }
  },
  "tts_emotion_from_text": {
    "class_type": "T8_IndexTTS25_EmotionControl",
    "_meta": {
      "title": "Emotion from [emotion] words"
    },
    "inputs": {
      "mode": "text",
      "mode.emotion_text": [
        "tts_emotion_text",
        0
      ],
      "mode.strength": 1.0
    }
  },
  "tts_emotion_from_voice": {
    "class_type": "T8_IndexTTS25_EmotionControl",
    "_meta": {
      "title": "Emotion copied from the voice sample"
    },
    "inputs": {
      "mode": "speaker"
    }
  },
  "tts_emotion": {
    "class_type": "ComfySwitchNode",
    "_meta": {
      "title": "Pick emotion source"
    },
    "inputs": {
      "switch": [
        "tts_has_emotion",
        0
      ],
      "on_false": [
        "tts_emotion_from_voice",
        0
      ],
      "on_true": [
        "tts_emotion_from_text",
        0
      ]
    }
  },
  "tts_generate": {
    "class_type": "T8_IndexTTS25_Generate",
    "_meta": {
      "title": "Speak the line"
    },
    "inputs": {
      "model": [
        "tts_model",
        0
      ],
      "speaker_audio": [
        "h3_lipsync_load",
        0
      ],
      "text": [
        "tts_line",
        0
      ],
      "language": "EN",
      "duration_factor": 1.0,
      "target_duration_mode": "off",
      "target_duration_seconds": 0.0,
      "postprocess_preset": "off",
      "postprocess_strength": 1.0,
      "seed": "{{seed}}",
      "quality_retry_count": 0,
      "quality_asr_backend": "auto",
      "quality_asr_model": "base",
      "quality_asr_device": "auto",
      "quality_threshold": 0.82,
      "emotion": [
        "tts_emotion",
        0
      ]
    }
  },
  "tts_trim": {
    "class_type": "TrimAudioDuration",
    "_meta": {
      "title": "Fit speech to the shot"
    },
    "inputs": {
      "audio": [
        "tts_generate",
        0
      ],
      "start_index": 0.0,
      "duration": "{{duration}}"
    }
  }
}
