{
  "h3_unet": {
    "inputs": {
      "unet_name": "{{unet}}",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load MiniMax H3 (pruned int8)"
    }
  },
  "h3_clip": {
    "inputs": {
      "clip_name": "{{clip}}",
      "type": "minimax",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load CLIP"
    }
  },
  "h3_video_vae": {
    "inputs": {
      "vae_name": "{{vae}}"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load Video VAE"
    }
  },
  "h3_audio_vae": {
    "inputs": {
      "vae_name": "{{audio_vae}}"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load Audio VAE"
    }
  },
  "simpligen_lora_1": {
    "inputs": {
      "PowerLoraLoaderHeaderWidget": {
        "type": "PowerLoraLoaderHeaderWidget"
      },
      "➕ Add Lora": "",
      "model": [
        "h3_unet",
        0
      ],
      "clip": [
        "h3_clip",
        0
      ]
    },
    "class_type": "Power Lora Loader (rgthree)",
    "_meta": {
      "title": "SimpliGen User LoRAs"
    }
  },
  "h3_conditioning": {
    "inputs": {
      "clip": [
        "simpligen_lora_1",
        1
      ],
      "vae": [
        "h3_video_vae",
        0
      ],
      "prompt": "{{prompt}}",
      "width": [
        "h3_s1_w",
        1
      ],
      "height": [
        "h3_s1_h",
        1
      ],
      "length": [
        "h3_length",
        1
      ]
    },
    "class_type": "MiniMaxH3ImageToVideo",
    "_meta": {
      "title": "MiniMax H3 Conditioning"
    }
  },
  "h3_noise": {
    "inputs": {
      "noise_seed": "{{seed}}"
    },
    "class_type": "RandomNoise",
    "_meta": {
      "title": "Random Noise"
    }
  },
  "h3_guider": {
    "inputs": {
      "model": [
        "h3_shift",
        0
      ],
      "conditioning": [
        "h3_conditioning",
        0
      ]
    },
    "class_type": "BasicGuider",
    "_meta": {
      "title": "Guider (stage 1)"
    }
  },
  "h3_sampler": {
    "inputs": {
      "sampler_name": "res_multistep"
    },
    "class_type": "KSamplerSelect",
    "_meta": {
      "title": "Sampler"
    }
  },
  "h3_sigmas": {
    "inputs": {
      "model": [
        "h3_shift",
        0
      ],
      "scheduler": "simple",
      "steps": "{{steps}}",
      "denoise": 1
    },
    "class_type": "BasicScheduler",
    "_meta": {
      "title": "Scheduler"
    }
  },
  "h3_sampling": {
    "inputs": {
      "noise": [
        "h3_noise",
        0
      ],
      "guider": [
        "h3_guider",
        0
      ],
      "sampler": [
        "h3_sampler",
        0
      ],
      "sigmas": [
        "h3_sigmas",
        0
      ],
      "latent_image": [
        "h3_conditioning",
        1
      ]
    },
    "class_type": "SamplerCustomAdvanced",
    "_meta": {
      "title": "Sample (stage 1, full steps, small)"
    }
  },
  "h3_decode_video": {
    "inputs": {
      "samples": [
        "h3_s2_sampling",
        0
      ],
      "vae": [
        "h3_video_vae",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decode Video"
    }
  },
  "h3_decode_audio": {
    "inputs": {
      "samples": [
        "h3_s2_sampling",
        0
      ],
      "vae": [
        "h3_audio_vae",
        0
      ]
    },
    "class_type": "VAEDecodeAudio",
    "_meta": {
      "title": "Decode Audio"
    }
  },
  "h3_create_video": {
    "inputs": {
      "images": [
        "h3_decode_video",
        0
      ],
      "fps": 24,
      "audio": [
        "h3_decode_audio",
        0
      ],
      "bit_depth": 8
    },
    "class_type": "CreateVideo",
    "_meta": {
      "title": "Create Video"
    }
  },
  "h3_save": {
    "inputs": {
      "video": [
        "h3_create_video",
        0
      ],
      "filename_prefix": "video/MiniMax_H3_twostage_t2v",
      "format": "auto",
      "codec": "auto"
    },
    "class_type": "SaveVideo",
    "_meta": {
      "title": "Save Video"
    }
  },
  "h3_duration": {
    "inputs": {
      "value": "{{duration}}"
    },
    "class_type": "PrimitiveFloat",
    "_meta": {
      "title": "Duration (seconds)"
    }
  },
  "h3_length": {
    "inputs": {
      "expression": "min(362, max(124, max(5, round(a * 24)) + (17 - (max(5, round(a * 24)) - 5) % 17) % 17))",
      "values.a": [
        "h3_duration",
        0
      ]
    },
    "class_type": "ComfyMathExpression",
    "_meta": {
      "title": "Frame Length"
    }
  },
  "h3_s1_w": {
    "class_type": "ComfyMathExpression",
    "_meta": {
      "title": "Stage 1 width"
    },
    "inputs": {
      "expression": "max(320, round(float(a) * 0.45 / 32) * 32)",
      "values.a": "{{width}}"
    }
  },
  "h3_s1_h": {
    "class_type": "ComfyMathExpression",
    "_meta": {
      "title": "Stage 1 height"
    },
    "inputs": {
      "expression": "max(320, round(float(a) * 0.45 / 32) * 32)",
      "values.a": "{{height}}"
    }
  },
  "h3_tgt_w": {
    "class_type": "ComfyMathExpression",
    "_meta": {
      "title": "Target width"
    },
    "inputs": {
      "expression": "round(float(a))",
      "values.a": "{{width}}"
    }
  },
  "h3_tgt_h": {
    "class_type": "ComfyMathExpression",
    "_meta": {
      "title": "Target height"
    },
    "inputs": {
      "expression": "round(float(a))",
      "values.a": "{{height}}"
    }
  },
  "h3_shift": {
    "class_type": "MiniMaxH3SigmaShift",
    "_meta": {
      "title": "Sigma Shift (stage 1)"
    },
    "inputs": {
      "model": [
        "simpligen_lora_1",
        0
      ],
      "shift_video": 12.0,
      "shift_audio": 3.0
    }
  },
  "h3_av_split": {
    "class_type": "LTXVSeparateAVLatent",
    "_meta": {
      "title": "Separate A/V latent"
    },
    "inputs": {
      "av_latent": [
        "h3_sampling",
        0
      ]
    }
  },
  "h3_upscale": {
    "class_type": "MinimaxH3LatentUpscaler3D",
    "_meta": {
      "title": "H3 Latent Upscaler (3D)"
    },
    "inputs": {
      "latent": [
        "h3_av_split",
        0
      ],
      "model_name": "minimax_h3_latent_upscaler_3d_fp16.safetensors",
      "mode": "target dimensions",
      "mode.width": [
        "h3_tgt_w",
        1
      ],
      "mode.height": [
        "h3_tgt_h",
        1
      ],
      "align": 32,
      "enable_temporal_chunking": true,
      "force_unload": true,
      "device": "cuda",
      "precision": "fp16"
    }
  },
  "h3_av_join": {
    "class_type": "LTXVConcatAVLatent",
    "_meta": {
      "title": "Re-join A/V latent"
    },
    "inputs": {
      "video_latent": [
        "h3_upscale",
        0
      ],
      "audio_latent": [
        "h3_av_split",
        1
      ]
    }
  },
  "h3_s2_lora": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "Turbo 4-step LoRA (stage 2 only)"
    },
    "inputs": {
      "lora_name": "minimax_h3_fl2v_turbo_4step_v1.0_768p_comfyui_bf16.safetensors",
      "strength_model": 1.0,
      "model": [
        "simpligen_lora_1",
        0
      ]
    }
  },
  "h3_s2_shift": {
    "class_type": "MiniMaxH3SigmaShift",
    "_meta": {
      "title": "Sigma Shift (stage 2)"
    },
    "inputs": {
      "model": [
        "h3_s2_lora",
        0
      ],
      "shift_video": 12.0,
      "shift_audio": 3.0
    }
  },
  "h3_s2_guider": {
    "class_type": "BasicGuider",
    "_meta": {
      "title": "Guider (stage 2)"
    },
    "inputs": {
      "model": [
        "h3_s2_shift",
        0
      ],
      "conditioning": [
        "h3_conditioning",
        0
      ]
    }
  },
  "h3_s2_sampler": {
    "class_type": "KSamplerSelect",
    "_meta": {
      "title": "Sampler (stage 2)"
    },
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "h3_s2_sigmas": {
    "class_type": "ManualSigmas",
    "_meta": {
      "title": "Stage 2 schedule"
    },
    "inputs": {
      "sigmas": "0.9035, 0.6316, 0.3158, 0.0000"
    }
  },
  "h3_s2_sampling": {
    "class_type": "SamplerCustomAdvanced",
    "_meta": {
      "title": "Sample (stage 2, Turbo refine, full size)"
    },
    "inputs": {
      "noise": [
        "h3_noise",
        0
      ],
      "guider": [
        "h3_s2_guider",
        0
      ],
      "sampler": [
        "h3_s2_sampler",
        0
      ],
      "sigmas": [
        "h3_s2_sigmas",
        0
      ],
      "latent_image": [
        "h3_av_join",
        0
      ]
    }
  }
}
