  "h3_duration": {
    "inputs": {
      "value": "{{duration}}"
    },
    "class_type": "PrimitiveFloat",
    "_meta": {
      "title": "Duration (seconds)"
    }
  },
  "h3_length": {
    "inputs": {
      "expression": "min(362, max(124, max(5, round(a * 24)) + (17 - (max(5, round(a * 24)) - 5) % 17) % 17))",
      "values.a": [
        "h3_duration",
        0
      ]
    },
    "class_type": "ComfyMathExpression",
    "_meta": {
      "title": "Snap length to the 17k+5 grid"
    }
  },
  "h3_s1_w": {
    "class_type": "ComfyMathExpression",
    "_meta": {
      "title": "Stage 1 width"
    },
    "inputs": {
      "expression": "max(320, round(float(a) * 0.45 / 32) * 32)",
      "values.a": "{{width}}"
    }
  },
  "h3_s1_h": {
    "class_type": "ComfyMathExpression",
    "_meta": {
      "title": "Stage 1 height"
    },
    "inputs": {
      "expression": "max(320, round(float(a) * 0.45 / 32) * 32)",
      "values.a": "{{height}}"
    }
  },
  "h3_tgt_w": {
    "class_type": "ComfyMathExpression",
    "_meta": {
      "title": "Target width"
    },
    "inputs": {
      "expression": "round(float(a))",
      "values.a": "{{width}}"
    }
  },
  "h3_tgt_h": {
    "class_type": "ComfyMathExpression",
    "_meta": {
      "title": "Target height"
    },
    "inputs": {
      "expression": "round(float(a))",
      "values.a": "{{height}}"
    }
  },
  "h3_shift": {
    "class_type": "MiniMaxH3SigmaShift",
    "_meta": {
      "title": "Sigma Shift (stage 1)"
    },
    "inputs": {
      "model": [
        "simpligen_lora_1",
        0
      ],
      "shift_video": 12.0,
      "shift_audio": 3.0
    }
  },
  "h3_av_split": {
    "class_type": "LTXVSeparateAVLatent",
    "_meta": {
      "title": "Separate A/V latent"
    },
    "inputs": {
      "av_latent": [
        "h3_sampling",
        0
      ]
    }
  },
  "h3_upscale": {
    "class_type": "MinimaxH3LatentUpscaler3D",
    "_meta": {
      "title": "H3 Latent Upscaler (3D)"
    },
    "inputs": {
      "latent": [
        "h3_av_split",
        0
      ],
      "model_name": "minimax_h3_latent_upscaler_3d_fp16.safetensors",
      "mode": "target dimensions",
      "mode.width": [
        "h3_tgt_w",
        1
      ],
      "mode.height": [
        "h3_tgt_h",
        1
      ],
      "align": 32,
      "enable_temporal_chunking": true,
      "force_unload": true,
      "device": "cuda",
      "precision": "fp16"
    }
  },
  "h3_av_join": {
    "class_type": "LTXVConcatAVLatent",
    "_meta": {
      "title": "Re-join A/V latent"
    },
    "inputs": {
      "video_latent": [
        "h3_upscale",
        0
      ],
      "audio_latent": [
        "h3_av_split",
        1
      ]
    }
  },
  "h3_s2_lora": {
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "Turbo 4-step LoRA (stage 2 only)"
    },
    "inputs": {
      "lora_name": "minimax_h3_fl2v_turbo_4step_v1.0_768p_comfyui_bf16.safetensors",
      "strength_model": 1.0,
      "model": [
        "simpligen_lora_1",
        0
      ]
    }
  },
  "h3_s2_shift": {
    "class_type": "MiniMaxH3SigmaShift",
    "_meta": {
      "title": "Sigma Shift (stage 2)"
    },
    "inputs": {
      "model": [
        "h3_s2_lora",
        0
      ],
      "shift_video": 12.0,
      "shift_audio": 3.0
    }
  },
  "h3_s2_guider": {
    "class_type": "BasicGuider",
    "_meta": {
      "title": "Guider (stage 2)"
    },
    "inputs": {
      "model": [
        "h3_s2_shift",
        0
      ],
      "conditioning": [
        "h3_conditioning",
        0
      ]
    }
  },
  "h3_s2_sampler": {
    "class_type": "KSamplerSelect",
    "_meta": {
      "title": "Sampler (stage 2)"
    },
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "h3_s2_sigmas": {
    "class_type": "ManualSigmas",
    "_meta": {
      "title": "Stage 2 schedule"
    },
    "inputs": {
      "sigmas": "0.9035, 0.6316, 0.3158, 0.0000"
    }
  },
  "h3_s2_sampling": {
    "class_type": "SamplerCustomAdvanced",
    "_meta": {
      "title": "Sample (stage 2, Turbo refine, full size)"
    },
    "inputs": {
      "noise": [
        "h3_noise",
        0
      ],
      "guider": [
        "h3_s2_guider",
        0
      ],
      "sampler": [
        "h3_s2_sampler",
        0
      ],
      "sigmas": [
        "h3_s2_sigmas",
        0
      ],
      "latent_image": [
        "h3_av_join",
        0
      ]
    }
  }
}
