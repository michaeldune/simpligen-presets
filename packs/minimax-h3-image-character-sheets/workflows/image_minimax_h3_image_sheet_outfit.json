{
  "sg_unet": {
    "inputs": {
      "unet_name": "{{unet}}",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load MiniMax H3-Image"
    }
  },
  "simpligen_lora_1": {
    "inputs": {
      "PowerLoraLoaderHeaderWidget": {
        "type": "PowerLoraLoaderHeaderWidget"
      },
      "➕ Add Lora": "",
      "model": [
        "sg_unet",
        0
      ]
    },
    "class_type": "Power Lora Loader (rgthree)",
    "_meta": {
      "title": "SimpliGen User LoRAs"
    }
  },
  "sg_te": {
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load H3 text encoder (32B nvfp4)"
    }
  },
  "sg_vae": {
    "inputs": {
      "vae_name": "{{vae}}"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load H3-Image VAE"
    }
  },
  "sg_neg": {
    "inputs": {
      "conditioning": [
        "sg_cond",
        0
      ]
    },
    "class_type": "ConditioningZeroOut",
    "_meta": {
      "title": "Negative (zeroed)"
    }
  },
  "sg_ksampler": {
    "inputs": {
      "model": [
        "simpligen_lora_1",
        0
      ],
      "positive": [
        "sg_cond",
        0
      ],
      "negative": [
        "sg_neg",
        0
      ],
      "latent_image": [
        "sg_cond",
        1
      ],
      "seed": {{seed}},
      "steps": 6,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler (6 steps, cfg 1)"
    }
  },
  "sg_decode": {
    "inputs": {
      "samples": [
        "sg_ksampler",
        0
      ],
      "vae": [
        "sg_vae",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "sg_save": {
    "inputs": {
      "images": [
        "sg_decode",
        0
      ],
      "filename_prefix": "minimax_h3_image_sheet_outfit"
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save"
    }
  },
  "sgopt_ref_image_1__load": {
    "inputs": {
      "image": "{{ref_image_1}}"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Picture 1"
    }
  },
  "sgopt_ref_image_1__scale": {
    "inputs": {
      "input": [
        "sgopt_ref_image_1__load",
        0
      ],
      "resize_type": "scale total pixels",
      "resize_type.megapixels": 4.0,
      "scale_method": "area"
    },
    "class_type": "ResizeImageMaskNode",
    "_meta": {
      "title": "Picture 1 at 4 MP"
    }
  },
  "sgopt_ref_image_1__fit": {
    "inputs": {
      "input": [
        "sgopt_ref_image_1__scale",
        0
      ],
      "resize_type": "scale to multiple",
      "resize_type.multiple": 32,
      "scale_method": "area"
    },
    "class_type": "ResizeImageMaskNode",
    "_meta": {
      "title": "Picture 1 to a multiple of 32"
    }
  },
  "sg_cond": {
    "inputs": {
      "clip": [
        "sg_te",
        0
      ],
      "vae": [
        "sg_vae",
        0
      ],
      "prompt": [
        "sg_request",
        0
      ],
      "width": 3712,
      "height": 4256,
      "images.image_1": [
        "sgopt_ref_image_1__fit",
        0
      ]
    },
    "class_type": "MiniMaxH3ImageConditioning",
    "_meta": {
      "title": "MiniMax H3 Image Conditioning"
    }
  },
  "sg_brief": {
    "inputs": {
      "value": "Create one outfit sheet from the clothes worn in <Picture 1>.\nShow only the clothes, laid flat on a plain white background like a flat-lay product photo. There is no person, head, face, hair, wig, hands, skin or mannequin anywhere in the picture.\nTwo views side by side, each appearing exactly once, separated by white space: on the left the whole outfit from the front, on the right the same whole outfit from the back. In each view, every garment and accessory from <Picture 1> appears once, at its full length, in its natural place: tops above bottoms, a matching pair of shoes below. Show only garments and accessories that <Picture 1> shows; add nothing new.\nKeep the colours, materials, patterns, logos and rendering style of <Picture 1>. Do not add prints, numbers or lettering that <Picture 1> does not show. No text, labels, borders or divider lines."
    },
    "class_type": "PrimitiveStringMultiline",
    "_meta": {
      "title": "Character sheet brief (outfit, H3 Character Sheet Designer v1.5.0)"
    }
  },
  "sg_request": {
    "inputs": {
      "string_a": [
        "sg_brief",
        0
      ],
      "string_b": "{{prompt}}",
      "delimiter": "\n"
    },
    "class_type": "StringConcatenate",
    "_meta": {
      "title": "Brief + your notes"
    }
  }
}
