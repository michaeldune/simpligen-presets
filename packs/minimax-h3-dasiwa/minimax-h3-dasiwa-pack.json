{
  "id": "minimax-h3-dasiwa-pack",
  "name": "Community — MiniMax H3 (DaSiWa Hybrid)",
  "version": "1.0.0",
  "author": "Darksidewalker",
  "nsfw": false,
  "description": "The fast MiniMax H3 pack. Darksidewalker's DaSiWa Hybrid 4Turbo is a finetune of the pruned int8 ConvRot weights with the distillation baked in, so it runs at four steps with no Turbo LoRA and nothing to install beyond what SimpliGen already ships — unlike the other H3 packs, which need the ComfyUI-MiniMax-H3-Turbo node cloned in by hand. One checkpoint covers text, image and reference to video, where every other H3 pack needs two - about 19.5 GB less to download for the same three presets. Roughly 1.7-2.3 minutes per five-second shot against about 3 for the six-step Turbo LoRA preset, with no audible change to the generated audio. Needs a Civitai API key: the author requires sign-in to download, though the model itself is free.",
  "tags": [
    "Local",
    "Video",
    "T2V",
    "I2V",
    "R2V",
    "MiniMax H3",
    "Turbo",
    "Hybrid"
  ],
