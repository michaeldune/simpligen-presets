{
  "h3_unet": {
    "inputs": {
      "unet_name": "{{unet}}",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "MiniMax H3 Diffusion Model"
    }
  },
  "h3_clip": {
    "inputs": {
      "clip_name": "{{clip}}",
      "type": "minimax",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Qwen3-VL Text Encoder (MiniMax)"
    }
  },
  "h3_video_vae": {
    "inputs": {
      "vae_name": "{{vae}}"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Video VAE"
    }
  },
  "h3_audio_vae": {
    "inputs": {
      "vae_name": "{{audio_vae}}"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Audio VAE"
    }
  },
  "simpligen_lora_1": {
    "inputs": {
      "PowerLoraLoaderHeaderWidget": {
        "type": "PowerLoraLoaderHeaderWidget"
      },
      "➕ Add Lora": "",
      "model": [
        "h3_unet",
        0
      ],
      "clip": [
        "h3_clip",
        0
      ]
    },
    "class_type": "Power Lora Loader (rgthree)",
    "_meta": {
      "title": "SimpliGen User LoRAs"
    }
  },
  "h3_conditioning": {
    "inputs": {
      "clip": [
        "simpligen_lora_1",
        1
      ],
      "vae": [
        "h3_video_vae",
        0
      ],
      "prompt": "{{prompt}}",
      "width": "{{width}}",
      "height": "{{height}}",
      "length": [
        "h3_length",
        1
      ],
      "first_frame": [
        "h3_first_frame_fit",
        0
      ]
    },
    "class_type": "MiniMaxH3ImageToVideo",
    "_meta": {
      "title": "MiniMax H3 Image to Video (first frame only)"
    }
  },
  "h3_conditioning_flf": {
    "inputs": {
      "clip": [
        "simpligen_lora_1",
        1
      ],
      "vae": [
        "h3_video_vae",
        0
      ],
      "prompt": "{{prompt}}",
      "width": "{{width}}",
      "height": "{{height}}",
      "length": [
        "h3_length",
        1
      ],
      "first_frame": [
        "h3_first_frame_fit",
        0
      ],
      "last_frame": [
        "h3_last_frame_fit",
        0
      ]
    },
    "class_type": "MiniMaxH3ImageToVideo",
    "_meta": {
      "title": "MiniMax H3 Image to Video (first + last frame)"
    }
  },
  "h3_last_frame_enabled": {
    "inputs": {
      "value": {{ref_2_enabled}}
    },
    "class_type": "PrimitiveBoolean",
    "_meta": {
      "title": "Last Frame Enabled"
    }
  },
  "h3_conditioning_switch": {
    "inputs": {
      "switch": [
        "h3_last_frame_enabled",
        0
      ],
      "on_false": [
        "h3_conditioning",
        0
      ],
      "on_true": [
        "h3_conditioning_flf",
        0
      ]
    },
    "class_type": "ComfySwitchNode",
    "_meta": {
      "title": "Conditioning: with or without a last frame"
    }
  },
  "h3_latent_switch": {
    "inputs": {
      "switch": [
        "h3_last_frame_enabled",
        0
      ],
      "on_false": [
        "h3_conditioning",
        1
      ],
      "on_true": [
        "h3_conditioning_flf",
        1
      ]
    },
    "class_type": "ComfySwitchNode",
    "_meta": {
      "title": "Latent: with or without a last frame"
    }
  },
  "h3_first_frame_fit": {
    "inputs": {
      "image": [
        "h3_load_image",
        0
      ],
      "upscale_method": "lanczos",
      "width": "{{width}}",
      "height": "{{height}}",
      "crop": "center"
    },
    "class_type": "ImageScale",
    "_meta": {
      "title": "Fit first frame to the output shape (center crop)"
    }
  },
  "h3_last_frame_fit": {
    "inputs": {
      "image": [
        "h3_load_image_2",
        0
      ],
      "upscale_method": "lanczos",
      "width": "{{width}}",
      "height": "{{height}}",
      "crop": "center"
    },
    "class_type": "ImageScale",
    "_meta": {
      "title": "Fit last frame to the output shape (center crop)"
    }
  },
  "h3_noise": {
    "inputs": {
      "noise_seed": "{{seed}}"
    },
    "class_type": "RandomNoise",
    "_meta": {
      "title": "Random Noise"
    }
  },
  "h3_guider": {
    "inputs": {
      "model": [
        "h3_pdd_apply",
        0
      ],
      "conditioning": [
        "h3_conditioning_switch",
        0
      ]
    },
    "class_type": "BasicGuider",
    "_meta": {
      "title": "Basic Guider"
    }
  },
  "h3_sampler": {
    "inputs": {
      "sampler_name": "euler"
    },
    "class_type": "KSamplerSelect",
    "_meta": {
      "title": "KSampler Select"
    }
  },
  "h3_sampling": {
    "inputs": {
      "noise": [
        "h3_noise",
        0
      ],
      "guider": [
        "h3_guider",
        0
      ],
      "sampler": [
        "h3_sampler",
        0
      ],
      "sigmas": [
        "h3_pdd_apply",
        1
      ],
      "latent_image": [
        "h3_latent_switch",
        0
      ]
    },
    "class_type": "SamplerCustomAdvanced",
    "_meta": {
      "title": "SamplerCustomAdvanced"
    }
  },
  "h3_decode_video": {
    "inputs": {
      "samples": [
        "h3_sampling",
        0
      ],
      "vae": [
        "h3_video_vae",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "h3_decode_audio": {
    "inputs": {
      "samples": [
        "h3_sampling",
        0
      ],
      "vae": [
        "h3_audio_vae",
        0
      ]
    },
    "class_type": "VAEDecodeAudio",
    "_meta": {
      "title": "VAE Decode Audio"
    }
  },
  "h3_create_video": {
    "inputs": {
      "images": [
        "h3_decode_video",
        0
      ],
      "fps": 24,
      "audio": [
        "h3_decode_audio",
        0
      ],
      "bit_depth": 8
    },
    "class_type": "CreateVideo",
    "_meta": {
      "title": "Create Video"
    }
  },
  "h3_save": {
    "inputs": {
      "video": [
        "h3_create_video",
        0
      ],
      "filename_prefix": "video/MiniMax_H3_i2v",
      "format": "auto",
      "codec": "auto"
    },
    "class_type": "SaveVideo",
    "_meta": {
      "title": "Save Video"
    }
  },
  "h3_load_image": {
    "inputs": {
      "image": "{{ref_image_1}}",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "First Frame"
    }
  },
  "h3_load_image_2": {
    "inputs": {
      "image": "{{ref_image_2}}",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Last Frame (optional)"
    }
  },
  "h3_duration": {
    "inputs": {
      "value": "{{duration}}"
    },
    "class_type": "PrimitiveFloat",
    "_meta": {
      "title": "Duration (seconds)"
    }
  },
  "h3_length": {
    "inputs": {
      "expression": "min(362, max(124, max(5, round(a * 24)) + (17 - (max(5, round(a * 24)) - 5) % 17) % 17))",
      "values.a": [
        "h3_duration",
        0
      ]
    },
    "class_type": "ComfyMathExpression",
    "_meta": {
      "title": "Snap length to the 17k+5 grid"
    }
  },
  "h3_pdd_shift": {
    "inputs": {
      "model": [
        "simpligen_lora_1",
        0
      ],
      "shift_video": 12.0,
      "shift_audio": 3.0
    },
    "class_type": "MiniMaxH3SigmaShift",
    "_meta": {
      "title": "Sigma Shift 12/3 (required by PDD)"
    }
  },
  "h3_pdd_apply": {
    "inputs": {
      "model": [
        "h3_pdd_shift",
        0
      ],
      "pdd_file": "MiniMax-H3-FL2VA-Acc-8Step.safetensors",
      "nfe": "8",
      "lora_strength": 1.0,
      "head_strength": 1.0,
      "on_off_grid": "error"
    },
    "class_type": "MiniMaxH3PDDAccApply",
    "_meta": {
      "title": "MiniMax H3 PDD Acc LoRA (Apply)"
    }
  }
}
