{
  "ckpt": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "Load All-in-One Checkpoint"
    },
    "inputs": {
      "ckpt_name": "{{checkpoint}}"
    }
  },
  "simpligen_lora_1": {
    "class_type": "Power Lora Loader (rgthree)",
    "_meta": {
      "title": "SimpliGen User LoRAs"
    },
    "inputs": {
      "PowerLoraLoaderHeaderWidget": {
        "type": "PowerLoraLoaderHeaderWidget"
      },
      "➕ Add Lora": "",
      "model": [
        "ckpt",
        0
      ],
      "clip": [
        "ckpt",
        1
      ]
    }
  },
  "positive": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive Prompt"
    },
    "inputs": {
      "text": "{{prompt}}",
      "clip": [
        "simpligen_lora_1",
        1
      ]
    }
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative Prompt"
    },
    "inputs": {
      "text": "{{negative_prompt}}",
      "clip": [
        "simpligen_lora_1",
        1
      ]
    }
  },
  "simpligen_width": {
    "class_type": "PrimitiveInt",
    "_meta": {
      "title": "Width"
    },
    "inputs": {
      "value": {{width}}
    }
  },
  "simpligen_height": {
    "class_type": "PrimitiveInt",
    "_meta": {
      "title": "Height"
    },
    "inputs": {
      "value": {{height}}
    }
  },
  "latent": {
    "class_type": "EmptyFlux2LatentImage",
    "_meta": {
      "title": "Empty Latent"
    },
    "inputs": {
      "width": [
        "simpligen_width",
        0
      ],
      "height": [
        "simpligen_height",
        0
      ],
      "batch_size": 1
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler"
    },
    "inputs": {
      "seed": {{seed}},
      "steps": {{steps}},
      "cfg": {{cfg}},
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": [
        "simpligen_lora_1",
        0
      ],
      "positive": [
        "positive",
        0
      ],
      "negative": [
        "negative",
        0
      ],
      "latent_image": [
        "latent",
        0
      ]
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    },
    "inputs": {
      "samples": [
        "sampler",
        0
      ],
      "vae": [
        "ckpt",
        2
      ]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image"
    },
    "inputs": {
      "filename_prefix": "moss-anime-turbo-aio",
      "images": [
        "decode",
        0
      ]
    }
  }
}
