    "_meta": {
      "title": "Chain: fit tail to output size"
    }
  },
  "chain_tail_audio_start": {
    "inputs": {
      "expression": "max(0, a - 22) / 24.0",
      "values.a": [
        "chain_prev_count",
        3
      ]
    },
    "class_type": "ComfyMathExpression",
    "_meta": {
