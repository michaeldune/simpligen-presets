      "title": "Chain: previous clip frame count"
    }
  },
  "chain_tail_start": {
    "inputs": {
      "expression": "max(0, a - 22)",
      "values.a": [
        "chain_prev_count",
        3
      ]
    },
    "class_type": "ComfyMathExpression",
    "_meta": {
