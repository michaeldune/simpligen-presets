{
  "sg_unet": {
    "inputs": {
      "unet_name": "{{unet}}",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Diffusion Model"
    }
  },
  "sg_clip": {
    "inputs": {
      "clip_name": "{{clip}}",
      "type": "qwen_image",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load Qwen3-VL 8B"
    }
  },
  "sg_vae": {
    "inputs": {
      "vae_name": "{{vae}}"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load VAE"
    }
  },
  "simpligen_lora_1": {
    "inputs": {
      "PowerLoraLoaderHeaderWidget": {
        "type": "PowerLoraLoaderHeaderWidget"
      },
      "➕ Add Lora": "",
      "model": [
        "sg_unet",
        0
      ],
      "clip": [
        "sg_clip",
        0
      ]
    },
    "class_type": "Power Lora Loader (rgthree)",
    "_meta": {
      "title": "SimpliGen User LoRAs"
    }
  },
  "sg_encode": {
    "inputs": {
      "clip": [
        "simpligen_lora_1",
        1
      ],
      "vae": [
        "sg_vae",
        0
      ],
      "prompt": "{{prompt}}",
      "negative_prompt": "{{negative_prompt}}",
      "resolution": 1024
    },
    "class_type": "TextEncodeQwenImage21",
    "_meta": {
      "title": "Prompt"
    }
  },
  "sg_latent": {
    "inputs": {
      "width": {{width}},
      "height": {{height}},
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "Empty latent"
    }
  },
  "sg_apg": {
    "inputs": {
      "model": [
        "simpligen_lora_1",
        0
      ],
      "eta": 1.0,
      "norm_threshold": 10.0,
      "momentum": 0.3
    },
    "class_type": "APG",
    "_meta": {
      "title": "Adaptive Projected Guidance"
    }
  },
  "sg_fresca": {
    "inputs": {
      "model": [
        "sg_apg",
        0
      ],
      "scale_low": 1.0,
      "scale_high": 2.0,
      "freq_cutoff": 8
    },
    "class_type": "FreSca",
    "_meta": {
      "title": "FreSca"
    }
  },
  "sg_sampler": {
    "inputs": {
      "seed": {{seed}},
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "seeds_2",
      "scheduler": "sgm_uniform",
      "denoise": 1,
      "model": [
        "sg_fresca",
        0
      ],
      "positive": [
        "sg_encode",
        0
      ],
      "negative": [
        "sg_encode",
        1
      ],
      "latent_image": [
        "sg_latent",
        0
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler"
    }
  },
  "sg_decode": {
    "inputs": {
      "samples": [
        "sg_sampler",
        0
      ],
      "vae": [
        "sg_vae",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "sg_save": {
    "inputs": {
      "filename_prefix": "qwen_image_21",
      "images": [
        "sg_decode",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save"
    }
  }
}