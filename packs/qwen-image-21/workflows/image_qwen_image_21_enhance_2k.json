{
  "sg_unet": {
    "inputs": {
      "unet_name": "{{unet}}",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Diffusion Model"
    }
  },
  "sg_clip": {
    "inputs": {
      "clip_name": "{{clip}}",
      "type": "qwen_image",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load Qwen3-VL 8B"
    }
  },
  "sg_vae": {
    "inputs": {
      "vae_name": "{{vae}}"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load VAE"
    }
  },
  "simpligen_lora_1": {
    "inputs": {
      "PowerLoraLoaderHeaderWidget": {
        "type": "PowerLoraLoaderHeaderWidget"
      },
      "➕ Add Lora": "",
      "model": [
        "sg_detail_lora",
        0
      ],
      "clip": [
        "sg_clip",
        0
      ]
    },
    "class_type": "Power Lora Loader (rgthree)",
    "_meta": {
      "title": "SimpliGen User LoRAs"
    }
  },
  "sg_detail_lora": {
    "inputs": {
      "model": [
        "sg_unet",
        0
      ],
      "lora_name": "elusarcas-qwen2-1-detailer-v1.safetensors",
      "strength_model": 1
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "Detail Enhancer LoRA (Elusarca)"
    }
  },
  "sg_cache": {
    "inputs": {
      "model": [
        "simpligen_lora_1",
        0
      ],
      "device": "auto",
      "dtype": "default"
    },
    "class_type": "QwenImage21Cache",
    "_meta": {
      "title": "Reference prefix cache"
    }
  },
  "sgopt_ref_image_1__load": {
    "inputs": {
      "image": "{{ref_image_1}}"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Picture to enhance"
    }
  },
  "big": {
    "inputs": {
      "image": [
        "sgopt_ref_image_1__load",
        0
      ],
      "upscale_method": "lanczos",
      "megapixels": 4.0,
      "resolution_steps": 32
    },
    "class_type": "ImageScaleToTotalPixels",
    "_meta": {
      "title": "Scale to about 4 MP (keeps the shape)"
    }
  },
  "big_size": {
    "inputs": {
      "image": [
        "big",
        0
      ]
    },
    "class_type": "GetImageSize",
    "_meta": {
      "title": "Output size"
    }
  },
  "brief": {
    "inputs": {
      "string_a": "enhance this image. Enhance this image to high resolution with rich fine details. Sharpen textures and surfaces, add natural microdetails, and improve clarity and definition across the image while preserving the original composition, lighting, atmosphere, and visual style.",
      "string_b": "{{prompt}}",
      "delimiter": " "
    },
    "class_type": "StringConcatenate",
    "_meta": {
      "title": "Brief + your notes"
    }
  },
  "sg_encode": {
    "inputs": {
      "clip": [
        "simpligen_lora_1",
        1
      ],
      "vae": [
        "sg_vae",
        0
      ],
      "prompt": [
        "brief",
        0
      ],
      "negative_prompt": "{{negative_prompt}}",
      "resolution": 1024,
      "images.image_1": [
        "big",
        0
      ]
    },
    "class_type": "TextEncodeQwenImage21",
    "_meta": {
      "title": "Brief + picture"
    }
  },
  "sg_latent": {
    "inputs": {
      "width": [
        "big_size",
        0
      ],
      "height": [
        "big_size",
        1
      ],
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "2K latent"
    }
  },
  "sg_sampler": {
    "inputs": {
      "seed": {{seed}},
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1,
      "model": [
        "sg_cache",
        0
      ],
      "positive": [
        "sg_encode",
        0
      ],
      "negative": [
        "sg_encode",
        1
      ],
      "latent_image": [
        "sg_latent",
        0
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler"
    }
  },
  "sg_decode": {
    "inputs": {
      "samples": [
        "sg_sampler",
        0
      ],
      "vae": [
        "sg_vae",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "sg_save": {
    "inputs": {
      "filename_prefix": "qwen_image_21_enhance",
      "images": [
        "sg_decode",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save"
    }
  }
}