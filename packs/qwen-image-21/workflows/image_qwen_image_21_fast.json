{
  "sg_unet": {
    "inputs": {
      "unet_name": "{{unet}}",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Diffusion Model"
    }
  },
  "sg_clip": {
    "inputs": {
      "clip_name": "{{clip}}",
      "type": "qwen_image",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load Qwen3-VL 8B"
    }
  },
  "sg_vae": {
    "inputs": {
      "vae_name": "{{vae}}"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load VAE"
    }
  },
  "simpligen_lora_1": {
    "inputs": {
      "PowerLoraLoaderHeaderWidget": {
        "type": "PowerLoraLoaderHeaderWidget"
      },
      "➕ Add Lora": "",
      "model": [
        "sg_unet",
        0
      ],
      "clip": [
        "sg_clip",
        0
      ]
    },
    "class_type": "Power Lora Loader (rgthree)",
    "_meta": {
      "title": "SimpliGen User LoRAs"
    }
  },
  "sg_turbo": {
    "inputs": {
      "lora_name": "Qwen-Image-2.1-viggle-turbo-v0.2-5step-lora-r256.safetensors",
      "strength_model": 1.0,
      "model": [
        "simpligen_lora_1",
        0
      ]
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "Viggle turbo v0.2 (5 steps)"
    }
  },
  "sg_encode": {
    "inputs": {
      "clip": [
        "simpligen_lora_1",
        1
      ],
      "vae": [
        "sg_vae",
        0
      ],
      "prompt": "{{prompt}}",
      "negative_prompt": "",
      "resolution": 1024
    },
    "class_type": "TextEncodeQwenImage21",
    "_meta": {
      "title": "Prompt"
    }
  },
  "sg_latent": {
    "inputs": {
      "width": {{width}},
      "height": {{height}},
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "Empty latent"
    }
  },
  "sg_sigmas": {
    "inputs": {
      "sigmas": "1.0, 0.93446, 0.85833, 0.66667, 0.40000, 0.0"
    },
    "class_type": "ManualSigmas",
    "_meta": {
      "title": "Viggle 5-step nodes [1, .875, .75, .5, .25], time-shifted for ~1 MP (mu 0.6935)"
    }
  },
  "sg_sampler_select": {
    "inputs": {
      "sampler_name": "euler"
    },
    "class_type": "KSamplerSelect",
    "_meta": {
      "title": "Sampler"
    }
  },
  "sg_sampler": {
    "inputs": {
      "add_noise": true,
      "noise_seed": {{seed}},
      "cfg": 1.0,
      "model": [
        "sg_turbo",
        0
      ],
      "positive": [
        "sg_encode",
        0
      ],
      "negative": [
        "sg_encode",
        1
      ],
      "sampler": [
        "sg_sampler_select",
        0
      ],
      "sigmas": [
        "sg_sigmas",
        0
      ],
      "latent_image": [
        "sg_latent",
        0
      ]
    },
    "class_type": "SamplerCustom",
    "_meta": {
      "title": "Sampler (5 steps, CFG 1)"
    }
  },
  "sg_decode": {
    "inputs": {
      "samples": [
        "sg_sampler",
        0
      ],
      "vae": [
        "sg_vae",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "sg_save": {
    "inputs": {
      "filename_prefix": "qwen_image_21_fast",
      "images": [
        "sg_decode",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save"
    }
  }
}
